<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Modul Penjualan</h2>
    <div class="d-flex gap-2 align-items-center">
        <button type="button" class="btn btn-sm btn-outline-info text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#modalTelegramReport">
            ✈️ Tutup Kasir / Telegram
        </button>
        <a href="/kas/kecil" class="badge bg-success fs-6 text-decoration-none" title="Klik lihat history Kas Kecil">Kas Kecil (Outlet): Rp <%= kasKecil.toLocaleString('id-ID') %> • Klik history</a>
    </div>
</div>
<small class="text-muted d-block mb-3">Kas outlet real-time — setiap penjualan/pengeluaran mengubah Kas/QRIS terpilih. Karyawan: Kas Kecil & QRIS.</small>

<div class="row">
    <div class="col-md-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white">Input Transaksi Baru</div>
            <div class="card-body">
                <form action="/sales" method="POST" enctype="multipart/form-data" onsubmit="return validatePenjualan(this)">
                    <!-- Mode Transaksi: 1 Motor vs 2 Motor (Bayar Bareng) -->
                    <div class="mb-3">
                        <label class="form-label fw-bold d-flex justify-content-between align-items-center mb-1">
                            <span>Jumlah Motor</span>
                            <span class="badge bg-primary" id="badgeMotorMode">🏍️ 1 Motor</span>
                        </label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="motor_mode_btn" id="mode1Motor" value="1" checked onchange="switchMotorMode('1')">
                            <label class="btn btn-outline-success fw-bold py-2" for="mode1Motor">
                                🏍️ 1 Motor
                            </label>

                            <input type="radio" class="btn-check" name="motor_mode_btn" id="mode2Motor" value="2" onchange="switchMotorMode('2')">
                            <label class="btn btn-outline-success fw-bold py-2" for="mode2Motor">
                                👥 2 Motor (Bayar Bareng)
                            </label>
                        </div>
                        <input type="hidden" name="motor_count" id="motorCountInput" value="1">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nama Pelanggan / Pemilik</label>
                        <input type="text" name="customer_name" class="form-control" required minlength="2" maxlength="50" placeholder="Nama Pemilik Kendaraan">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">No WhatsApp (Opsional)</label>
                        <input type="text" name="phone" class="form-control" maxlength="20" placeholder="081234567890">
                    </div>

                    <!-- Input Plat Nomor (Mode 1 Motor) -->
                    <div id="platSingleWrap" class="mb-3">
                        <label class="form-label fw-bold">Plat Nomor <span class="text-danger">*</span></label>
                        <input type="text" id="platSingleInput" class="form-control text-uppercase" placeholder="Contoh: DD 1234 ABC" maxlength="20" oninput="syncPlat()">
                    </div>

                    <!-- Input Plat Nomor (Mode 2 Motor) -->
                    <div id="platDoubleWrap" class="mb-3 p-3 bg-light border border-success rounded" style="display:none;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-success" style="font-size: 13px;">👥 Plat 2 Motor (Bayar Bareng)</span>
                            <span class="badge bg-success" style="font-size: 10px;">1 Lembar Struk</span>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small fw-bold mb-1">🏍️ Motor 1 <span class="text-danger">*</span></label>
                                <input type="text" id="plat1Input" class="form-control text-uppercase form-control-sm" placeholder="DD 1234 AB" maxlength="15" oninput="syncPlat()">
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold mb-1">🏍️ Motor 2 <span class="text-danger">*</span></label>
                                <input type="text" id="plat2Input" class="form-control text-uppercase form-control-sm" placeholder="DD 5678 CD" maxlength="15" oninput="syncPlat()">
                            </div>
                        </div>
                        <small class="text-muted d-block mt-2" style="font-size: 11px;">Struk nota tercantum: <strong id="platPreviewStr" class="text-dark">-</strong></small>
                    </div>

                    <!-- Input Plat Sebenarnya yang Dikirim ke Server -->
                    <input type="hidden" name="license_plate" id="licensePlateHidden" required>

                    <div class="mb-3">
                        <label class="form-label fw-bold d-flex justify-content-between align-items-center">
                            <span>Jenis Layanan</span>
                            <span class="badge bg-secondary" id="layananSubtitleBadge">1 Cuci Motor + Tambahan</span>
                        </label>
                        <div class="border rounded p-2" style="max-height:260px; overflow-y:auto; background:#fff;">
                            <% 
                                const isCuciUtama = (name) => /cuci\s+(motor|mobil)/i.test(name || '');
                                const cuciServices = (services || []).filter(s => isCuciUtama(s.name));
                                const addonServices = (services || []).filter(s => !isCuciUtama(s.name));
                            %>

                            <% if (services.length===0) { %>
                                <small class="text-muted">Belum ada layanan. Tambah di Master.</small>
                            <% } %>

                            <!-- MODE 1 MOTOR: Checklist Cuci Motor (Pilih Maks 1) -->
                            <div id="cuci1MotorWrap">
                                <% if (cuciServices.length > 0) { %>
                                    <div class="d-flex justify-content-between align-items-center mb-1 pb-1 border-bottom">
                                        <span class="badge bg-primary" style="font-size: 11px;">🏍️ Paket Cuci Motor (Pilih Maks 1)</span>
                                        <small class="text-muted" style="font-size: 10px;">Otomatis ganti jika klik yang lain</small>
                                    </div>
                                    <% cuciServices.forEach(s => { %>
                                        <div class="form-check py-1">
                                            <input class="form-check-input layanan-check layanan-cuci" type="checkbox" name="service_names" value="<%= s.name %>" data-price="<%= s.price %>" data-commission="<%= s.commission || 0 %>" data-group="cuci" id="svc_<%= s.id %>" onchange="handleLayananChange(this)">
                                            <label class="form-check-label d-flex justify-content-between w-100" for="svc_<%= s.id %>">
                                                <span><%= s.name %></span>
                                                <span class="fw-bold text-dark">Rp <%= s.price.toLocaleString('id-ID') %></span>
                                            </label>
                                        </div>
                                    <% }) %>
                                <% } %>
                            </div>

                            <!-- MODE 2 MOTOR: Dropdown Paket Cuci untuk Motor 1 & Motor 2 -->
                            <div id="cuci2MotorWrap" style="display:none;">
                                <div class="p-2 mb-2 bg-light border border-primary rounded">
                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom">
                                        <span class="badge bg-primary" style="font-size: 11px;">🏍️ Paket Cuci 2 Motor</span>
                                        <small class="text-muted" style="font-size: 10px;">Bisa sama atau beda paket</small>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small fw-bold mb-1 text-primary">🏍️ Paket Motor 1 (Plat 1):</label>
                                        <select class="form-select form-select-sm cuci-2m-select" id="cuciMotor1Select" disabled onchange="updatePriceMulti()">
                                            <% cuciServices.forEach(s => { %>
                                                <option value="<%= s.name %>" data-price="<%= s.price %>" data-commission="<%= s.commission || 0 %>">
                                                    <%= s.name %> — Rp <%= s.price.toLocaleString('id-ID') %>
                                                </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="form-label small fw-bold mb-1 text-primary">🏍️ Paket Motor 2 (Plat 2):</label>
                                        <select class="form-select form-select-sm cuci-2m-select" id="cuciMotor2Select" disabled onchange="updatePriceMulti()">
                                            <% cuciServices.forEach(s => { %>
                                                <option value="<%= s.name %>" data-price="<%= s.price %>" data-commission="<%= s.commission || 0 %>">
                                                    <%= s.name %> — Rp <%= s.price.toLocaleString('id-ID') %>
                                                </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- LAYANAN TAMBAHAN (Aktif di Kedua Mode) -->
                            <% if (addonServices.length > 0) { %>
                                <div class="d-flex justify-content-between align-items-center mt-2 mb-1 pt-2 pb-1 border-top border-bottom">
                                    <span class="badge bg-secondary" style="font-size: 11px;">✨ Layanan Tambahan / Poles (Bisa Tambah)</span>
                                    <small class="text-muted" style="font-size: 10px;">Bisa dipilih bersamaan</small>
                                </div>
                                <% addonServices.forEach(s => { %>
                                    <div class="form-check py-1">
                                        <input class="form-check-input layanan-check layanan-addon" type="checkbox" name="service_names" value="<%= s.name %>" data-price="<%= s.price %>" data-commission="<%= s.commission || 0 %>" data-group="addon" id="svc_<%= s.id %>" onchange="handleLayananChange(this)">
                                        <label class="form-check-label d-flex justify-content-between w-100" for="svc_<%= s.id %>">
                                            <span><%= s.name %></span>
                                            <span class="fw-bold text-dark">Rp <%= s.price.toLocaleString('id-ID') %></span>
                                        </label>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                        <small class="text-muted" id="layananHelpNote">Maksimal 1 paket cuci motor. Layanan tambahan (seperti Poles Helm) bisa dipilih bersamaan. Dipilih <span id="layananCount">0</span> layanan.</small>
                        <div class="invalid-feedback d-block" id="layananError" style="display:none !important;">Pilih minimal 1 layanan.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Harga Penjualan (Rp)</label>
                        <input type="text" name="price" id="price" class="form-control rupiah" required placeholder="Otomatis jumlah layanan (15.000)">
                        <small class="text-muted">Otomatis sum layanan, bisa edit manual (≥1.000).</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Pekerja (Pencuci)</label>
                        <select name="worker_name" class="form-select" required>
                            <option value="">-- Pilih Pekerja --</option>
                            <% workers.forEach(w => { %>
                                <option value="<%= w.name %>"><%= w.name %></option>
                            <% }) %>
                        </select>
                        <small class="text-muted">Kelola karyawan di <a href="/master">Master</a>.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Bayar Ke <small class="text-muted">(Kas Kecil / QRIS)</small></label>
                        <select name="akun_kas" id="akunKasSelect" class="form-select" required onchange="toggleQrisProof()">
                            <% accounts.forEach(a=>{ %>
                                <option value="<%= a.name %>" data-type="<%= a.type %>" <%= a.name==='Kas Kecil'?'selected':'' %>><%= a.name %> — <%= a.type %></option>
                            <% }) %>
                        </select>
                        <small class="text-muted">Karyawan & Owner pilih <strong>Kas Kecil</strong> (tunai) atau <strong>QRIS</strong>. Transaksi QRIS wajib foto bukti.</small>
                    </div>

                    <!-- Container Foto Bukti QRIS (Tampil HANYA jika QRIS dipilih) -->
                    <div id="qrisProofWrap" class="mb-3 p-3 border border-warning rounded bg-light" style="display:none;">
                        <label class="form-label fw-bold text-dark d-flex justify-content-between align-items-center mb-1">
                            <span>📸 Foto Bukti QRIS <span class="text-danger">*Wajib</span></span>
                            <small class="text-muted">(Maks 4MB)</small>
                        </label>
                        <small class="text-muted d-block mb-2">Wajib lampirkan foto struk / tangkapan layar pembayaran QRIS pelanggan.</small>

                        <div class="d-flex gap-2 mb-2">
                            <label class="btn btn-outline-primary btn-sm flex-fill mb-0">
                                <span>📁 Dari Galeri</span>
                                <input type="file" name="photo" id="photoQris" class="d-none" accept="image/*" onchange="previewQris(this)">
                            </label>
                            <button type="button" class="btn btn-outline-success btn-sm flex-fill" onclick="openKameraQris()">
                                <span>📷 Ambil Kamera</span>
                            </button>
                        </div>
                        <input type="file" id="fallbackKameraQris" class="d-none" accept="image/*" capture="environment" onchange="previewQris(this)">

                        <div id="previewQrisDisplay" class="mt-2 text-center" style="display:none;">
                            <img id="previewQrisImg" src="" alt="Bukti QRIS" style="max-width:100%; max-height:180px; border:1px solid #28a745; border-radius:6px; object-fit:contain;">
                            <div class="d-flex justify-content-center gap-2 mt-2">
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="hapusFotoQris()">Hapus / Ganti</button>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success w-100">Simpan & Cetak Struk</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <!-- Filter & Search Phase 3 -->
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <form method="GET" action="/sales" class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Dari Tanggal</label>
                        <input type="date" name="from" value="<%= query.from %>" class="form-control form-control-sm">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Sampai Tanggal</label>
                        <input type="date" name="to" value="<%= query.to %>" class="form-control form-control-sm">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1">Cari Plat/Nama/Layanan/Pekerja</label>
                        <input type="text" name="search" value="<%= query.search %>" class="form-control form-control-sm" placeholder="B 1234 / Budi / Cuci">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
                        <a href="/sales" class="btn btn-outline-secondary btn-sm w-100 mt-1">Reset</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                <span>Riwayat Transaksi</span>
                <small><%= total %> data • Hal <%= currentPage %>/<%= totalPages %></small>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Waktu</th>
                                <th>Plat & Pelanggan</th>
                                <th>Layanan</th>
                                <th>Total (Rp)</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (recentSales.length === 0) { %>
                                <tr><td colspan="5" class="text-center text-muted py-3">Tidak ada transaksi sesuai filter.</td></tr>
                            <% } %>
                            <% recentSales.forEach(s => { %>
                            <tr>
                                <td><small><%= typeof formatWitaDate === 'function' ? formatWitaDate(s.date, true) : new Date(s.date).toLocaleString('id-ID') %></small></td>
                                <td><%= s.license_plate %><br><small class="text-muted"><%= s.customer_name %></small><br><small class="badge bg-light text-dark"><%= s.worker_name %></small></td>
                                <td>
                                    <% (s.service_name||'').split(',').forEach((lay,idx)=>{ %>
                                        <span class="badge bg-success mb-1"><%= lay.trim() %></span><% if(idx < (s.service_name.split(',').length-1)) { %><br><% } %>
                                    <% }) %>
                                </td>
                                <td>
                                    <strong>Rp <%= s.price.toLocaleString('id-ID') %></strong><br>
                                    <% if (s.akun_kas && s.akun_kas.toLowerCase().includes('qris')) { %>
                                        <span class="badge bg-info text-dark">QRIS</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary"><%= s.akun_kas || 'Kas Kecil' %></span>
                                    <% } %>
                                    <% if (s.photo) { %>
                                        <div class="mt-1">
                                            <a href="<%= s.photo %>" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-1" style="font-size:11px;" title="Lihat Foto Bukti QRIS">
                                                📷 Bukti QRIS
                                            </a>
                                        </div>
                                    <% } %>
                                </td>
                                <td>
                                    <a href="/receipt/<%= s.id %>" class="btn btn-sm btn-outline-info" target="_blank">Struk</a>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Pagination -->
            <div class="card-footer d-flex justify-content-between align-items-center">
                <small class="text-muted">Tampil <%= recentSales.length %> dari <%= total %> • <%= limit %> per hal</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item <%= currentPage<=1?'disabled':'' %>"><a class="page-link" href="/sales?from=<%= query.from %>&to=<%= query.to %>&search=<%= encodeURIComponent(query.search) %>&page=<%= currentPage-1 %>&limit=<%= limit %>">«</a></li>
                        <% for(let i=1;i<=totalPages;i++){ if(i===1 || i===totalPages || (i>=currentPage-1 && i<=currentPage+1)){ %>
                            <li class="page-item <%= i===currentPage?'active':'' %>"><a class="page-link" href="/sales?from=<%= query.from %>&to=<%= query.to %>&search=<%= encodeURIComponent(query.search) %>&page=<%= i %>&limit=<%= limit %>"><%= i %></a></li>
                        <% } else if(i===currentPage-2 || i===currentPage+2){ %>
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        <% }} %>
                        <li class="page-item <%= currentPage>=totalPages?'disabled':'' %>"><a class="page-link" href="/sales?from=<%= query.from %>&to=<%= query.to %>&search=<%= encodeURIComponent(query.search) %>&page=<%= currentPage+1 %>&limit=<%= limit %>">»</a></li>
                    </ul>
                </nav>
                <form method="GET" action="/sales" class="d-flex gap-1">
                    <input type="hidden" name="from" value="<%= query.from %>">
                    <input type="hidden" name="to" value="<%= query.to %>">
                    <input type="hidden" name="search" value="<%= query.search %>">
                    <select name="limit" class="form-select form-select-sm" style="width:70px" onchange="this.form.submit()">
                        <option value="5" <%= limit==5?'selected':'' %>>5</option>
                        <option value="10" <%= limit==10?'selected':'' %>>10</option>
                        <option value="20" <%= limit==20?'selected':'' %>>20</option>
                        <option value="50" <%= limit==50?'selected':'' %>>50</option>
                    </select>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Kamera QRIS -->
<div class="modal fade" id="modalKameraQris" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h6 class="modal-title">Ambil Foto Bukti QRIS</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-2">
                <video id="videoKameraQris" autoplay playsinline muted style="width:100%; max-height:320px; background:#000; border-radius:8px;"></video>
                <canvas id="canvasCaptureQris" style="display:none"></canvas>
                <small id="kameraStatusQris" class="text-muted d-block mt-2">Izinkan kamera...</small>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="switchKameraQris()">🔄 Putar Kamera</button>
                <div>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                    <button type="button" class="btn btn-success btn-sm" onclick="captureFotoQris()">📸 Ambil</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function toggleQrisProof(){
    const sel = document.getElementById('akunKasSelect');
    const wrap = document.getElementById('qrisProofWrap');
    if(!sel || !wrap) return;
    const opt = sel.options[sel.selectedIndex];
    const isQris = (opt && opt.getAttribute('data-type') === 'QRIS') || (sel.value && sel.value.toLowerCase().includes('qris'));
    if(isQris){
        wrap.style.display = 'block';
    } else {
        wrap.style.display = 'none';
        hapusFotoQris();
    }
}

function previewQris(input){
    const wrap = document.getElementById('previewQrisDisplay');
    const img = document.getElementById('previewQrisImg');
    if(input.files && input.files[0]){
        const f = input.files[0];
        if(f.size > 4*1024*1024){
            alert('Ukuran foto maksimal 4MB');
            input.value = '';
            wrap.style.display = 'none';
            return;
        }
        if(!f.type.startsWith('image/')){
            alert('Hanya file gambar yang diperbolehkan');
            input.value = '';
            wrap.style.display = 'none';
            return;
        }
        const reader = new FileReader();
        reader.onload = e => {
            img.src = e.target.result;
            wrap.style.display = 'block';
        };
        reader.readAsDataURL(f);
    } else {
        wrap.style.display = 'none';
    }
}

function hapusFotoQris(){
    const inp = document.getElementById('photoQris');
    if(inp) inp.value = '';
    const fb = document.getElementById('fallbackKameraQris');
    if(fb) fb.value = '';
    const wrap = document.getElementById('previewQrisDisplay');
    if(wrap) wrap.style.display = 'none';
    const img = document.getElementById('previewQrisImg');
    if(img) img.src = '';
}

let streamKameraQris = null;
let currentFacingModeQris = 'environment';

function startKameraQris(mode){
    const video = document.getElementById('videoKameraQris');
    const status = document.getElementById('kameraStatusQris');
    if(streamKameraQris){
        streamKameraQris.getTracks().forEach(t => t.stop());
        streamKameraQris = null;
    }
    status.textContent = 'Meminta kamera (' + (mode === 'user' ? 'Depan' : 'Belakang') + ')...';
    const tryCam = (m) => navigator.mediaDevices.getUserMedia({
        video: { facingMode: m, width: { ideal: 1280 }, height: { ideal: 720 } },
        audio: false
    });

    tryCam(mode)
        .catch(() => tryCam(mode === 'user' ? 'environment' : 'user'))
        .then(s => {
            streamKameraQris = s;
            video.srcObject = s;
            video.muted = true;
            video.setAttribute('playsinline', '');
            video.setAttribute('autoplay', '');
            status.textContent = 'Kamera aktif (' + (mode === 'user' ? 'Depan' : 'Belakang') + ').';
            const play = () => video.play().catch(e => {
                video.addEventListener('click', () => video.play(), { once: true });
            });
            video.onloadedmetadata = play;
            video.oncanplay = play;
            setTimeout(play, 600);
        })
        .catch(err => {
            status.textContent = 'Gagal buka kamera: ' + err.message;
        });
}

function switchKameraQris(){
    currentFacingModeQris = (currentFacingModeQris === 'user') ? 'environment' : 'user';
    startKameraQris(currentFacingModeQris);
}

function openKameraQris(){
    if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
        const fb = document.getElementById('fallbackKameraQris');
        if(fb) fb.click();
        else alert('Kamera tidak didukung pada browser ini.');
        return;
    }
    const modalEl = document.getElementById('modalKameraQris');
    const modal = new bootstrap.Modal(modalEl);
    modal.show();
    currentFacingModeQris = 'environment';
    startKameraQris(currentFacingModeQris);
}

function captureFotoQris(){
    const video = document.getElementById('videoKameraQris');
    const canvas = document.getElementById('canvasCaptureQris');
    const previewWrap = document.getElementById('previewQrisDisplay');
    const previewImg = document.getElementById('previewQrisImg');
    const fileInput = document.getElementById('photoQris');
    if(!video.videoWidth || video.videoWidth < 10) return alert('Kamera belum siap, tunggu video tampil lalu coba lagi');
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    canvas.getContext('2d').drawImage(video, 0, 0);
    canvas.toBlob(blob => {
        if(!blob) return alert('Gagal memproses gambar');
        if(blob.size > 4*1024*1024) return alert('Foto melebihi 4MB');
        const file = new File([blob], 'qris_kamera_' + Date.now() + '.jpg', { type: 'image/jpeg' });
        const dt = new DataTransfer();
        dt.items.add(file);
        fileInput.files = dt.files;
        previewImg.src = URL.createObjectURL(blob);
        previewWrap.style.display = 'block';
        bootstrap.Modal.getInstance(document.getElementById('modalKameraQris')).hide();
        if(streamKameraQris){
            streamKameraQris.getTracks().forEach(t => t.stop());
            streamKameraQris = null;
        }
        video.srcObject = null;
    }, 'image/jpeg', 0.85);
}

let currentMotorMode = '1';

function switchMotorMode(mode) {
    currentMotorMode = mode;
    const motorCountInput = document.getElementById('motorCountInput');
    if (motorCountInput) motorCountInput.value = mode;

    const badge = document.getElementById('badgeMotorMode');
    const platSingleWrap = document.getElementById('platSingleWrap');
    const platDoubleWrap = document.getElementById('platDoubleWrap');
    const cuci1MotorWrap = document.getElementById('cuci1MotorWrap');
    const cuci2MotorWrap = document.getElementById('cuci2MotorWrap');
    const subtitleBadge = document.getElementById('layananSubtitleBadge');
    const helpNote = document.getElementById('layananHelpNote');

    const cuciChecks = document.querySelectorAll('.layanan-cuci');
    const cuci1Select = document.getElementById('cuciMotor1Select');
    const cuci2Select = document.getElementById('cuciMotor2Select');

    if (mode === '2') {
        if (badge) {
            badge.textContent = '👥 2 Motor (Bayar Bareng)';
            badge.className = 'badge bg-success';
        }
        if (platSingleWrap) platSingleWrap.style.display = 'none';
        if (platDoubleWrap) platDoubleWrap.style.display = 'block';
        if (cuci1MotorWrap) cuci1MotorWrap.style.display = 'none';
        if (cuci2MotorWrap) cuci2MotorWrap.style.display = 'block';
        if (subtitleBadge) subtitleBadge.textContent = '2 Cuci Motor + Tambahan';

        // Nonaktifkan checkbox cuci 1 motor dan aktifkan dropdown 2 motor
        cuciChecks.forEach(c => {
            c.disabled = true;
            c.checked = false;
        });
        if (cuci1Select) {
            cuci1Select.disabled = false;
            cuci1Select.name = 'service_names';
        }
        if (cuci2Select) {
            cuci2Select.disabled = false;
            cuci2Select.name = 'service_names';
        }
        if (helpNote) {
            helpNote.innerHTML = 'Mode 2 Motor: 2 paket cuci motor aktif. Tambahan seperti Poles Helm dapat diceklis. Total dipilih <span id="layananCount">2</span> layanan.';
        }
    } else {
        if (badge) {
            badge.textContent = '🏍️ 1 Motor';
            badge.className = 'badge bg-primary';
        }
        if (platSingleWrap) platSingleWrap.style.display = 'block';
        if (platDoubleWrap) platDoubleWrap.style.display = 'none';
        if (cuci1MotorWrap) cuci1MotorWrap.style.display = 'block';
        if (cuci2MotorWrap) cuci2MotorWrap.style.display = 'none';
        if (subtitleBadge) subtitleBadge.textContent = '1 Cuci Motor + Tambahan';

        // Aktifkan kembali checkbox cuci 1 motor dan matikan select 2 motor
        cuciChecks.forEach(c => {
            c.disabled = false;
        });
        if (cuci1Select) {
            cuci1Select.disabled = true;
            cuci1Select.removeAttribute('name');
        }
        if (cuci2Select) {
            cuci2Select.disabled = true;
            cuci2Select.removeAttribute('name');
        }
        if (helpNote) {
            helpNote.innerHTML = 'Maksimal 1 paket cuci motor. Layanan tambahan (seperti Poles Helm) bisa dipilih bersamaan. Dipilih <span id="layananCount">0</span> layanan.';
        }
    }

    syncPlat();
    updatePriceMulti();
}

function syncPlat() {
    const hiddenInput = document.getElementById('licensePlateHidden');
    const singleInput = document.getElementById('platSingleInput');
    const p1Input = document.getElementById('plat1Input');
    const p2Input = document.getElementById('plat2Input');
    const previewStr = document.getElementById('platPreviewStr');

    if (!hiddenInput) return;

    if (currentMotorMode === '2') {
        const p1 = (p1Input ? p1Input.value.trim() : '').toUpperCase();
        const p2 = (p2Input ? p2Input.value.trim() : '').toUpperCase();
        if (p1 && p2) {
            hiddenInput.value = p1 + ' / ' + p2;
            if (previewStr) previewStr.textContent = p1 + ' / ' + p2;
        } else if (p1) {
            hiddenInput.value = p1;
            if (previewStr) previewStr.textContent = p1 + ' / ...';
        } else if (p2) {
            hiddenInput.value = p2;
            if (previewStr) previewStr.textContent = '... / ' + p2;
        } else {
            hiddenInput.value = '';
            if (previewStr) previewStr.textContent = '-';
        }
    } else {
        const val = (singleInput ? singleInput.value.trim() : '').toUpperCase();
        hiddenInput.value = val;
    }
}

function handleLayananChange(el){
    // Jika kasir memilih satu jenis paket cuci motor di mode 1 motor, otomatis uncheck paket cuci motor lainnya
    if (el && el.checked && el.dataset.group === 'cuci') {
        const cuciChecks = document.querySelectorAll('.layanan-cuci');
        cuciChecks.forEach(c => {
            if (c !== el) {
                c.checked = false;
            }
        });
    }
    updatePriceMulti();
}

function updatePriceMulti(){
    let sum = 0;
    let count = 0;

    if (currentMotorMode === '2') {
        const cuci1 = document.getElementById('cuciMotor1Select');
        const cuci2 = document.getElementById('cuciMotor2Select');
        if (cuci1 && cuci1.selectedIndex >= 0) {
            const opt1 = cuci1.options[cuci1.selectedIndex];
            sum += parseInt(opt1.dataset.price || 0, 10);
            count++;
        }
        if (cuci2 && cuci2.selectedIndex >= 0) {
            const opt2 = cuci2.options[cuci2.selectedIndex];
            sum += parseInt(opt2.dataset.price || 0, 10);
            count++;
        }
    } else {
        const cuciChecks = document.querySelectorAll('.layanan-cuci:checked');
        cuciChecks.forEach(c => {
            sum += parseInt(c.dataset.price || 0, 10);
            count++;
        });
    }

    const addonChecks = document.querySelectorAll('.layanan-addon:checked');
    addonChecks.forEach(c => {
        sum += parseInt(c.dataset.price || 0, 10);
        count++;
    });

    const countEl = document.getElementById('layananCount');
    if (countEl) countEl.textContent = count;

    const priceEl = document.getElementById('price');
    if (priceEl) priceEl.value = sum > 0 ? formatRupiah(sum) : '';
}

function validatePenjualan(form){
    syncPlat();

    const hiddenPlat = document.getElementById('licensePlateHidden');
    const errEl = document.getElementById('layananError');

    if (currentMotorMode === '2') {
        const p1 = document.getElementById('plat1Input').value.trim();
        const p2 = document.getElementById('plat2Input').value.trim();
        if (!p1 || p1.length < 2) {
            alert('Validasi gagal: Harap masukkan Plat Nomor Motor 1 (minimal 2 karakter)!');
            document.getElementById('plat1Input').focus();
            return false;
        }
        if (!p2 || p2.length < 2) {
            alert('Validasi gagal: Harap masukkan Plat Nomor Motor 2 (minimal 2 karakter)!');
            document.getElementById('plat2Input').focus();
            return false;
        }
        hiddenPlat.value = (p1 + ' / ' + p2).toUpperCase();
    } else {
        const ps = document.getElementById('platSingleInput').value.trim();
        if (!ps || ps.length < 2) {
            alert('Validasi gagal: Harap masukkan Plat Nomor Kendaraan (minimal 2 karakter)!');
            document.getElementById('platSingleInput').focus();
            return false;
        }
        hiddenPlat.value = ps.toUpperCase();

        const cuciChecked = document.querySelectorAll('.layanan-cuci:checked');
        if (cuciChecked.length > 1) {
            alert('Validasi gagal: Hanya boleh memilih 1 paket cuci motor per transaksi di mode 1 Motor. Gunakan mode "2 Motor (Bayar Bareng)" jika ingin membayar 2 motor!');
            return false;
        }
        const anyChecked = document.querySelectorAll('.layanan-check:checked');
        if (anyChecked.length === 0) {
            if (errEl) { errEl.style.display = 'block'; errEl.textContent = 'Validasi gagal: Pilih minimal 1 layanan.'; }
            alert('Validasi gagal: Pilih minimal 1 layanan.');
            return false;
        } else if (errEl) {
            errEl.style.display = 'none';
        }
    }

    // Validasi Wajib Foto Bukti untuk QRIS
    const sel = form.akun_kas;
    if (sel) {
        const opt = sel.options[sel.selectedIndex];
        const isQris = (opt && opt.getAttribute('data-type') === 'QRIS') || (sel.value && sel.value.toLowerCase().includes('qris'));
        if (isQris) {
            const photoInput = document.getElementById('photoQris');
            if (!photoInput || !photoInput.files || photoInput.files.length === 0) {
                alert('Validasi gagal: Transaksi QRIS WAJIB melampirkan foto bukti pembayaran (dari Galeri atau Kamera)!');
                return false;
            }
        }
    }

    return validateRupiahForm(form);
}

// PWA Offline Logic
const OFFLINE_KEY = 'washpos_offline_sales';

function renderOfflineBanner() {
    let pending = JSON.parse(localStorage.getItem(OFFLINE_KEY) || '[]');
    let banner = document.getElementById('offlineBanner');
    if (pending.length > 0) {
        if (!banner) {
            banner = document.createElement('div');
            banner.id = 'offlineBanner';
            banner.className = 'alert alert-warning py-2 mt-3 mb-0';
            banner.innerHTML = `<strong>Mode Offline:</strong> Ada <span id="offlineCount"></span> transaksi belum tersinkronisasi. Akan dikirim otomatis saat online. <button class="btn btn-sm btn-outline-dark ms-2" type="button" onclick="syncOfflineSales(true)">Sync Manual</button>`;
            const formCard = document.querySelector('.col-md-4 .card');
            if(formCard) formCard.parentNode.insertBefore(banner, formCard.nextSibling);
        }
        document.getElementById('offlineCount').textContent = pending.length;
    } else if (banner) {
        banner.remove();
    }
}

async function syncOfflineSales(manual = false) {
    if (!navigator.onLine) {
        if (manual) alert("Masih tidak ada koneksi internet.");
        return;
    }
    let pending = JSON.parse(localStorage.getItem(OFFLINE_KEY) || '[]');
    if (pending.length === 0) return;
    
    let successCount = 0;
    for (let i = 0; i < pending.length; i++) {
        let p = pending[i];
        let fd = new URLSearchParams();
        for (let k in p) {
            if (Array.isArray(p[k])) p[k].forEach(v => fd.append(k, v));
            else fd.append(k, p[k]);
        }
        try {
            let res = await fetch('/sales', {
                method: 'POST',
                body: fd,
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
            });
            if (res.ok || res.status === 400 || res.redirected) {
                pending.splice(i, 1);
                i--;
                successCount++;
                localStorage.setItem(OFFLINE_KEY, JSON.stringify(pending));
                renderOfflineBanner();
            }
        } catch (e) {
            break; 
        }
    }
    if (successCount > 0) {
        showToast(`${successCount} transaksi offline berhasil disinkronkan!`);
        setTimeout(() => window.location.reload(), 2000);
    }
}

window.addEventListener('online', () => syncOfflineSales(false));
document.addEventListener('DOMContentLoaded', () => {
    switchMotorMode('1');
    toggleQrisProof();
    const modalEl = document.getElementById('modalKameraQris');
    if (modalEl) {
        modalEl.addEventListener('hidden.bs.modal', function () {
            if (streamKameraQris) {
                streamKameraQris.getTracks().forEach(t => t.stop());
                streamKameraQris = null;
            }
            const video = document.getElementById('videoKameraQris');
            if (video) video.srcObject = null;
        });
    }

    renderOfflineBanner();
    if (navigator.onLine) syncOfflineSales(false);
    
    const salesForm = document.querySelector('form[action="/sales"][method="POST"]');
    if (salesForm) {
        salesForm.addEventListener('submit', function(e) {
            if (!navigator.onLine) {
                e.preventDefault();
                let formData = new FormData(salesForm);
                let data = {};
                for (let key of formData.keys()) {
                    let vals = formData.getAll(key);
                    data[key] = vals.length > 1 ? vals : vals[0];
                }
                
                let pending = JSON.parse(localStorage.getItem(OFFLINE_KEY) || '[]');
                pending.push(data);
                localStorage.setItem(OFFLINE_KEY, JSON.stringify(pending));
                
                salesForm.reset();
                const priceEl = document.getElementById('price');
                if (priceEl) priceEl.value = '';
                const lc = document.getElementById('layananCount');
                if (lc) lc.textContent = '0';
                
                showToast("Tersimpan Offline! Akan dikirim saat online.", 'warning');
                renderOfflineBanner();
                
                setTimeout(() => {
                    const btn = salesForm.querySelector('button[type=submit]');
                    if(btn && btn.dataset.orig){
                        btn.disabled = false;
                        btn.innerHTML = btn.dataset.orig;
                    }
                }, 100);
            }
        });
    }
});
