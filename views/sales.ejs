let streamKameraQris = null;
let currentFacingModeQris = 'environment';

function startKameraQris(mode){
    const video = document.getElementById('videoKameraQris');
    const status = document.getElementById('kameraStatusQris');
    if(streamKameraQris){
        streamKameraQris.getTracks().forEach(t => t.stop());
        streamKameraQris = null;
    }
    status.textContent = 'Meminta kamera (' + (mode === 'user' ? 'Depan' : 'Belakang') + ')...';
    const tryCam = (m) => navigator.mediaDevices.getUserMedia({
        video: { facingMode: m, width: { ideal: 1280 }, height: { ideal: 720 } },
        audio: false
    });

    tryCam(mode)
        .catch(() => tryCam(mode === 'user' ? 'environment' : 'user'))
        .then(s => {
            streamKameraQris = s;
            video.srcObject = s;
            video.muted = true;
            video.setAttribute('playsinline', '');
            video.setAttribute('autoplay', '');
            status.textContent = 'Kamera aktif (' + (mode === 'user' ? 'Depan' : 'Belakang') + ').';
            const play = () => video.play().catch(e => {
                video.addEventListener('click', () => video.play(), { once: true });
            });
            video.onloadedmetadata = play;
            video.oncanplay = play;
            setTimeout(play, 600);
        })
        .catch(err => {
            status.textContent = 'Gagal buka kamera: ' + err.message;
        });
}

function switchKameraQris(){
    currentFacingModeQris = (currentFacingModeQris === 'user') ? 'environment' : 'user';
    startKameraQris(currentFacingModeQris);
}

function openKameraQris(){
    activeCameraMode = 'qris';
    const title = document.getElementById('modalKameraTitle');
    if(title) title.textContent = 'Ambil Foto Bukti QRIS';

    if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
        const fb = document.getElementById('fallbackKameraQris');
        if(fb) fb.click();
        else alert('Kamera tidak didukung pada browser ini.');
        return;
    }
    const modalEl = document.getElementById('modalKameraQris');
    const modal = new bootstrap.Modal(modalEl);
    modal.show();
    currentFacingModeQris = 'environment';
    startKameraQris(currentFacingModeQris);
}

function captureFotoQris(){
    const video = document.getElementById('videoKameraQris');
    const canvas = document.getElementById('canvasCaptureQris');
    if(!video.videoWidth || video.videoWidth < 10) return alert('Kamera belum siap, tunggu video tampil lalu coba lagi');
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    canvas.getContext('2d').drawImage(video, 0, 0);
    canvas.toBlob(blob => {
        if(!blob) return alert('Gagal memproses gambar');
        if(blob.size > 4*1024*1024) return alert('Foto melebihi 4MB');

        if (activeCameraMode === 'promo') {
            const promoInput = document.getElementById('promoPhotoInput');
            const promoWrap = document.getElementById('previewPromoDisplay');
            const promoImg = document.getElementById('previewPromoImg');
            const file = new File([blob], 'grab_kamera_' + Date.now() + '.jpg', { type: 'image/jpeg' });
            const dt = new DataTransfer();
            dt.items.add(file);
            if (promoInput) promoInput.files = dt.files;
            if (promoImg) promoImg.src = URL.createObjectURL(blob);
            if (promoWrap) promoWrap.style.display = 'block';
        } else {
            const file = new File([blob], 'qris_kamera_' + Date.now() + '.jpg', { type: 'image/jpeg' });
            const fileInput = document.getElementById('photoQris');
            const previewWrap = document.getElementById('previewQrisDisplay');
            const previewImg = document.getElementById('previewQrisImg');
            const dt = new DataTransfer();
            dt.items.add(file);
            if (fileInput) fileInput.files = dt.files;
            if (previewImg) previewImg.src = URL.createObjectURL(blob);
            if (previewWrap) previewWrap.style.display = 'block';
        }

        bootstrap.Modal.getInstance(document.getElementById('modalKameraQris')).hide();
        if(streamKameraQris){
            streamKameraQris.getTracks().forEach(t => t.stop());
            streamKameraQris = null;
        }
        video.srcObject = null;
    }, 'image/jpeg', 0.85);
}

// Data Layanan Cuci Motor & Karyawan (dari backend)
const CUCI_SERVICES = <%- JSON.stringify(cuciServices || []) %>;
const ALL_WORKERS = <%- JSON.stringify(workers || []) %>;

let currentMotorCount = 1;
let motorSlotsData = [
    { plat: '', service: CUCI_SERVICES[0] ? CUCI_SERVICES[0].name : 'Cuci Motor Besar', worker: '' }
];

function setMotorCount(count) {
    count = parseInt(count, 10);
    if (isNaN(count) || count < 1) count = 1;
    currentMotorCount = count;
    const motorCountInput = document.getElementById('motorCountInput');
    if (motorCountInput) motorCountInput.value = count;

    // Update status tombol pill
    document.querySelectorAll('.btn-motor-quick').forEach(btn => btn.classList.remove('active'));
    if (count === 1) {
        const btn1 = document.getElementById('btnM1');
        if (btn1) btn1.classList.add('active');
    } else if (count === 2) {
        const btn2 = document.getElementById('btnM2');
        if (btn2) btn2.classList.add('active');
    } else if (count === 3) {
        const btn3 = document.getElementById('btnM3');
        if (btn3) btn3.classList.add('active');
    }

    const badge = document.getElementById('badgeMotorMode');
    const platSingleWrap = document.getElementById('platSingleWrap');
    const multiMotorWrap = document.getElementById('multiMotorWrap');
    const multiMotorBadge = document.getElementById('multiMotorBadge');
    const cuci1MotorWrap = document.getElementById('cuci1MotorWrap');
    const cuciMultiInfoWrap = document.getElementById('cuciMultiInfoWrap');
    const subtitleBadge = document.getElementById('layananSubtitleBadge');
    const helpNote = document.getElementById('layananHelpNote');
    const cuciChecks = document.querySelectorAll('.layanan-cuci');
    const singleWorkerWrap = document.getElementById('singleWorkerWrap');
    const singleWorkerSelect = document.getElementById('singleWorkerSelect');

    if (count > 1) {
        if (badge) {
            badge.textContent = `👥 ${count} Motor (Rombongan)`;
            badge.className = 'badge bg-success';
        }
        if (multiMotorBadge) multiMotorBadge.textContent = `${count} Motor`;
        if (platSingleWrap) platSingleWrap.style.display = 'none';
        if (multiMotorWrap) multiMotorWrap.style.display = 'block';
        if (cuci1MotorWrap) cuci1MotorWrap.style.display = 'none';
        if (cuciMultiInfoWrap) cuciMultiInfoWrap.style.display = 'block';
        if (subtitleBadge) subtitleBadge.textContent = `${count} Cuci Motor + Tambahan`;
        if (singleWorkerWrap) singleWorkerWrap.style.display = 'none';
        if (singleWorkerSelect) singleWorkerSelect.removeAttribute('required');

        // Nonaktifkan checkbox cuci 1 motor
        cuciChecks.forEach(c => {
            c.disabled = true;
            c.checked = false;
        });

        // Sesuaikan jumlah elemen di motorSlotsData
        saveSlotsFromDom();
        while (motorSlotsData.length < count) {
            const defaultSvc = CUCI_SERVICES[0] ? CUCI_SERVICES[0].name : 'Cuci Motor Besar';
            const firstWorker = motorSlotsData[0] ? motorSlotsData[0].worker : '';
            motorSlotsData.push({ plat: '', service: defaultSvc, worker: firstWorker });
        }
        if (motorSlotsData.length > count) {
            motorSlotsData = motorSlotsData.slice(0, count);
        }

        renderMotorSlots();
        if (helpNote) {
            helpNote.innerHTML = `Mode Rombongan: ${count} paket cuci motor aktif. Tetapkan pencuci masing-masing motor. Total dipilih <span id="layananCount">${count}</span> layanan.`;
        }
    } else {
        if (badge) {
            badge.textContent = '🏍️ 1 Motor';
            badge.className = 'badge bg-primary';
        }
        if (platSingleWrap) platSingleWrap.style.display = 'block';
        if (multiMotorWrap) multiMotorWrap.style.display = 'none';
        if (cuci1MotorWrap) cuci1MotorWrap.style.display = 'block';
        if (cuciMultiInfoWrap) cuciMultiInfoWrap.style.display = 'none';
        if (subtitleBadge) subtitleBadge.textContent = '1 Cuci Motor + Tambahan';
        if (singleWorkerWrap) singleWorkerWrap.style.display = 'block';
        if (singleWorkerSelect) singleWorkerSelect.setAttribute('required', 'required');

        // Aktifkan kembali checkbox cuci 1 motor
        cuciChecks.forEach(c => {
            c.disabled = false;
        });

        motorSlotsData = [
            { plat: '', service: CUCI_SERVICES[0] ? CUCI_SERVICES[0].name : 'Cuci Motor Besar', worker: '' }
        ];
        renderMotorSlots();

        if (helpNote) {
            helpNote.innerHTML = 'Maksimal 1 paket cuci motor. Layanan tambahan (seperti Poles Helm) bisa dipilih bersamaan. Dipilih <span id="layananCount">0</span> layanan.';
        }
    }

    syncPlats();
    updatePriceMulti();
}

function addMotorSlot() {
    saveSlotsFromDom();
    setMotorCount(currentMotorCount + 1);
}

function removeMotorSlot(slotIndex) {
    saveSlotsFromDom();
    if (motorSlotsData.length <= 2) {
        setMotorCount(1);
        return;
    }
    motorSlotsData.splice(slotIndex - 1, 1);
    setMotorCount(motorSlotsData.length);
}

function saveSlotsFromDom() {
    for (let i = 0; i < motorSlotsData.length; i++) {
        const platEl = document.getElementById(`platSlot_${i + 1}`);
        const svcEl = document.getElementById(`svcSlot_${i + 1}`);
        const workerEl = document.getElementById(`workerSlot_${i + 1}`);
        if (platEl) motorSlotsData[i].plat = platEl.value.trim();
        if (svcEl) motorSlotsData[i].service = svcEl.value;
        if (workerEl) motorSlotsData[i].worker = workerEl.value;
    }
}

function renderMotorSlots() {
    const container = document.getElementById('motorSlotsContainer');
    if (!container) return;

    if (currentMotorCount <= 1) {
        container.innerHTML = '';
        return;
    }

    let html = '';
    motorSlotsData.forEach((slot, i) => {
        const idx = i + 1;
        let optionsHtml = '';
        CUCI_SERVICES.forEach(s => {
            const isSel = s.name === slot.service ? 'selected' : '';
            optionsHtml += `<option value="${s.name}" data-price="${s.price}" data-commission="${s.commission || 0}" ${isSel}>${s.name} — Rp ${Number(s.price).toLocaleString('id-ID')}</option>`;
        });

        let optionsWorkerHtml = '<option value="">-- Pilih Pencuci --</option>';
        ALL_WORKERS.forEach(w => {
            const isSel = w.name === slot.worker ? 'selected' : '';
            optionsWorkerHtml += `<option value="${w.name}" ${isSel}>${w.name}</option>`;
        });

        html += `
        <div class="card mb-2 border-success shadow-none motor-slot-card" id="slotCard_${idx}">
            <div class="card-header bg-white py-1 px-2 d-flex justify-content-between align-items-center">
                <span class="fw-bold text-success" style="font-size:12px;">🏍️ Motor #${idx}</span>
                ${currentMotorCount > 2 ? `<button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none fw-bold" onclick="removeMotorSlot(${idx})" style="font-size:11px;">✕ Hapus</button>` : ''}
            </div>
            <div class="card-body p-2 bg-light">
                <div class="row g-2">
                    <div class="col-md-4 col-12">
                        <label class="form-label small mb-1 fw-bold">Plat Motor #${idx} <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm text-uppercase motor-plat-input" id="platSlot_${idx}" name="motor_plats" placeholder="DD 1234 AB" maxlength="15" value="${slot.plat || ''}" oninput="onSlotPlatChange(${idx}, this.value)" required>
                    </div>
                    <div class="col-md-4 col-12">
                        <label class="form-label small mb-1 fw-bold">Paket Cuci #${idx} <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm motor-svc-select" id="svcSlot_${idx}" name="service_names" onchange="onSlotSvcChange(${idx}, this.value)">
                            ${optionsHtml}
                        </select>
                    </div>
                    <div class="col-md-4 col-12">
                        <label class="form-label small mb-1 fw-bold">Pencuci #${idx} <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm motor-worker-select" id="workerSlot_${idx}" name="motor_workers" onchange="onSlotWorkerChange(${idx}, this.value)" required>
                            ${optionsWorkerHtml}
                        </select>
                    </div>
                </div>
            </div>
        </div>
        `;
    });

    container.innerHTML = html;
}

function onSlotWorkerChange(idx, val) {
    if (motorSlotsData[idx - 1]) {
        motorSlotsData[idx - 1].worker = val;
    }
}

function copyWorkerToAll() {
    saveSlotsFromDom();
    if (!motorSlotsData[0] || !motorSlotsData[0].worker) {
        alert('Silakan pilih Pencuci untuk Motor #1 terlebih dahulu.');
        const firstEl = document.getElementById('workerSlot_1');
        if (firstEl) firstEl.focus();
        return;
    }
    const targetWorker = motorSlotsData[0].worker;
    for (let i = 1; i < motorSlotsData.length; i++) {
        motorSlotsData[i].worker = targetWorker;
    }
    renderMotorSlots();
    if (typeof showToast === 'function') {
        showToast(`Pencuci semua motor disamakan: ${targetWorker}`);
    }
}

function onSlotPlatChange(idx, val) {
    if (motorSlotsData[idx - 1]) {
        motorSlotsData[idx - 1].plat = val.trim();
    }
    syncPlats();
}

function onSlotSvcChange(idx, val) {
    if (motorSlotsData[idx - 1]) {
        motorSlotsData[idx - 1].service = val;
    }
    updatePriceMulti();
}

function syncPlats() {
    const hiddenInput = document.getElementById('licensePlateHidden');
    const singleInput = document.getElementById('platSingleInput');
    const previewStr = document.getElementById('platPreviewStr');

    if (!hiddenInput) return;

    if (currentMotorCount > 1) {
        saveSlotsFromDom();
        const plates = motorSlotsData.map(s => s.plat.trim().toUpperCase()).filter(Boolean);
        hiddenInput.value = plates.join(' / ');
        if (previewStr) previewStr.textContent = hiddenInput.value || '-';
    } else {
        const val = (singleInput ? singleInput.value.trim() : '').toUpperCase();
        hiddenInput.value = val;
    }
}

function handleLayananChange(el){
    // Jika kasir memilih satu jenis paket cuci motor di mode 1 motor, otomatis uncheck paket cuci motor lainnya
    if (el && el.checked && el.dataset.group === 'cuci') {
        const cuciChecks = document.querySelectorAll('.layanan-cuci');
        cuciChecks.forEach(c => {
            if (c !== el) {
                c.checked = false;
            }
        });
    }
    updatePriceMulti();
}

function updatePriceMulti(){
    let sum = 0;
    let count = 0;

    if (currentMotorCount > 1) {
        saveSlotsFromDom();
        motorSlotsData.forEach(slot => {
            const svc = CUCI_SERVICES.find(s => s.name === slot.service);
            if (svc) {
                sum += parseInt(svc.price || 0, 10);
            }
            count++;
        });
    } else {
        const cuciChecks = document.querySelectorAll('.layanan-cuci:checked');
        cuciChecks.forEach(c => {
            sum += parseInt(c.dataset.price || 0, 10);
            count++;
        });
    }

    const addonChecks = document.querySelectorAll('.layanan-addon:checked');
    addonChecks.forEach(c => {
        sum += parseInt(c.dataset.price || 0, 10);
        count++;
    });

    const countEl = document.getElementById('layananCount');
    if (countEl) countEl.textContent = count;

    // Perhitungan Promo Driver Grab (Diskon Rp 5.000 / Motor)
    const promoToggle = document.getElementById('promoGrabToggle');
    const isPromo = promoToggle && promoToggle.checked;
    const motorCount = currentMotorCount > 1 ? (motorSlotsData ? motorSlotsData.length : currentMotorCount) : 1;
    const discount = isPromo ? (5000 * motorCount) : 0;

    const discountInput = document.getElementById('discountInput');
    if (discountInput) discountInput.value = discount;
    const promoNameInput = document.getElementById('promoNameInput');
    if (promoNameInput) promoNameInput.value = isPromo ? 'Promo Driver Grab' : '';

    const promoDetails = document.getElementById('promoGrabDetails');
    const promoText = document.getElementById('promoGrabDiscountText');
    if (promoDetails) promoDetails.style.display = isPromo ? 'block' : 'none';
    if (promoText) promoText.textContent = `-Rp ${formatRupiah(discount)} (${motorCount} Motor)`;

    const finalPrice = Math.max(0, sum - discount);
    const priceEl = document.getElementById('price');
    if (priceEl) priceEl.value = finalPrice > 0 ? formatRupiah(finalPrice) : '';

    const priceNote = document.getElementById('priceNote');
    if (priceNote) {
        if (isPromo && sum > 0) {
            priceNote.innerHTML = `<span class="text-success fw-bold">🛵 Diskon Grab Aktif:</span> Rp ${formatRupiah(sum)} - Rp ${formatRupiah(discount)} = <strong>Rp ${formatRupiah(finalPrice)}</strong>`;
        } else {
            priceNote.innerHTML = 'Otomatis sum layanan, bisa edit manual (≥1.000).';
        }
    }
}

function validatePenjualan(form){
    syncPlats();

    const hiddenPlat = document.getElementById('licensePlateHidden');
    const errEl = document.getElementById('layananError');

    if (currentMotorCount > 1) {
        saveSlotsFromDom();
        for (let i = 0; i < motorSlotsData.length; i++) {
            const p = motorSlotsData[i].plat.trim();
            if (!p || p.length < 2) {
                alert(`Validasi gagal: Harap masukkan Plat Nomor untuk Motor #${i + 1} (minimal 2 karakter)!`);
                const inputEl = document.getElementById(`platSlot_${i + 1}`);
                if (inputEl) inputEl.focus();
                return false;
            }
            const w = (motorSlotsData[i].worker || '').trim();
            if (!w) {
                alert(`Validasi gagal: Harap pilih Pencuci untuk Motor #${i + 1}!`);
                const wEl = document.getElementById(`workerSlot_${i + 1}`);
                if (wEl) wEl.focus();
                return false;
            }
        }
        hiddenPlat.value = motorSlotsData.map(s => s.plat.trim().toUpperCase()).join(' / ');

        // Simpan daftar pencuci unik ke singleWorkerSelect agar worker_name terkirim
        const uniqueWorkers = [...new Set(motorSlotsData.map(s => s.worker).filter(Boolean))];
        const sw = document.getElementById('singleWorkerSelect');
        if (sw) {
            const combinedVal = uniqueWorkers.join(', ');
            let opt = sw.querySelector(`option[value="${combinedVal}"]`);
            if (!opt) {
                opt = document.createElement('option');
                opt.value = combinedVal;
                sw.appendChild(opt);
            }
            sw.value = combinedVal;
        }
    } else {
        const ps = document.getElementById('platSingleInput').value.trim();
        if (!ps || ps.length < 2) {
            alert('Validasi gagal: Harap masukkan Plat Nomor Kendaraan (minimal 2 karakter)!');
            document.getElementById('platSingleInput').focus();
            return false;
        }
        hiddenPlat.value = ps.toUpperCase();

        const cuciChecked = document.querySelectorAll('.layanan-cuci:checked');
        if (cuciChecked.length > 1) {
            alert('Validasi gagal: Hanya boleh memilih 1 paket cuci motor per transaksi di mode 1 Motor. Gunakan mode rombongan jika ingin membayar lebih dari 1 motor!');
            return false;
        }
        const anyChecked = document.querySelectorAll('.layanan-check:checked');
        if (anyChecked.length === 0) {
            if (errEl) { errEl.style.display = 'block'; errEl.textContent = 'Validasi gagal: Pilih minimal 1 layanan.'; }
            alert('Validasi gagal: Pilih minimal 1 layanan.');
            return false;
        } else if (errEl) {
            errEl.style.display = 'none';
        }
    }

    // Validasi Wajib Foto Bukti untuk Promo Driver Grab
    const promoToggle = document.getElementById('promoGrabToggle');
    if (promoToggle && promoToggle.checked) {
        const promoInput = document.getElementById('promoPhotoInput');
        if (!promoInput || !promoInput.files || promoInput.files.length === 0) {
            alert('Validasi gagal: Transaksi Promo Driver Grab WAJIB melampirkan foto bukti (layar aplikasi Grab Driver aktif / motor bersama atribut Grab)!');
            return false;
        }
    }

    // Validasi Wajib Foto Bukti untuk QRIS
    const sel = form.akun_kas;
    if (sel) {
        const opt = sel.options[sel.selectedIndex];
        const isQris = (opt && opt.getAttribute('data-type') === 'QRIS') || (sel.value && sel.value.toLowerCase().includes('qris'));
        if (isQris) {
            const photoInput = document.getElementById('photoQris');
            if (!photoInput || !photoInput.files || photoInput.files.length === 0) {
                alert('Validasi gagal: Transaksi QRIS WAJIB melampirkan foto bukti pembayaran (dari Galeri atau Kamera)!');
                return false;
            }
        }
    }

    return validateRupiahForm(form);
}

// PWA Offline Logic
const OFFLINE_KEY = 'washpos_offline_sales';

function renderOfflineBanner() {
    let pending = JSON.parse(localStorage.getItem(OFFLINE_KEY) || '[]');
    let banner = document.getElementById('offlineBanner');
    if (pending.length > 0) {
        if (!banner) {
            banner = document.createElement('div');
            banner.id = 'offlineBanner';
            banner.className = 'alert alert-warning py-2 mt-3 mb-0';
            banner.innerHTML = `<strong>Mode Offline:</strong> Ada <span id="offlineCount"></span> transaksi belum tersinkronisasi. Akan dikirim otomatis saat online. <button class="btn btn-sm btn-outline-dark ms-2" type="button" onclick="syncOfflineSales(true)">Sync Manual</button>`;
            const formCard = document.querySelector('.col-md-4 .card');
            if(formCard) formCard.parentNode.insertBefore(banner, formCard.nextSibling);
        }
        document.getElementById('offlineCount').textContent = pending.length;
    } else if (banner) {
        banner.remove();
    }
}

async function syncOfflineSales(manual = false) {
    if (!navigator.onLine) {
        if (manual) alert("Masih tidak ada koneksi internet.");
        return;
    }
    let pending = JSON.parse(localStorage.getItem(OFFLINE_KEY) || '[]');
    if (pending.length === 0) return;
    
    let successCount = 0;
    for (let i = 0; i < pending.length; i++) {
        let p = pending[i];
        let fd = new URLSearchParams();
        for (let k in p) {
            if (Array.isArray(p[k])) p[k].forEach(v => fd.append(k, v));
            else fd.append(k, p[k]);
        }
        try {
            let res = await fetch('/sales', {
                method: 'POST',
                body: fd,
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
            });
            if (res.ok || res.status === 400 || res.redirected) {
                pending.splice(i, 1);
                i--;
                successCount++;
                localStorage.setItem(OFFLINE_KEY, JSON.stringify(pending));
                renderOfflineBanner();
            }
        } catch (e) {
            break; 
        }
    }
    if (successCount > 0) {
        showToast(`${successCount} transaksi offline berhasil disinkronkan!`);
        setTimeout(() => window.location.reload(), 2000);
    }
}

window.addEventListener('online', () => syncOfflineSales(false));
document.addEventListener('DOMContentLoaded', () => {
    setMotorCount(1);
    toggleQrisProof();
    const modalEl = document.getElementById('modalKameraQris');
    if (modalEl) {
        modalEl.addEventListener('hidden.bs.modal', function () {
            if (streamKameraQris) {
                streamKameraQris.getTracks().forEach(t => t.stop());
                streamKameraQris = null;
            }
            const video = document.getElementById('videoKameraQris');
            if (video) video.srcObject = null;
        });
    }

    renderOfflineBanner();
    if (navigator.onLine) syncOfflineSales(false);
    
    const salesForm = document.querySelector('form[action="/sales"][method="POST"]');
    if (salesForm) {
        salesForm.addEventListener('submit', function(e) {
            if (!navigator.onLine) {
                e.preventDefault();
                let formData = new FormData(salesForm);
                let data = {};
                for (let key of formData.keys()) {
                    let vals = formData.getAll(key);
                    data[key] = vals.length > 1 ? vals : vals[0];
                }
                
                let pending = JSON.parse(localStorage.getItem(OFFLINE_KEY) || '[]');
                pending.push(data);
                localStorage.setItem(OFFLINE_KEY, JSON.stringify(pending));
                
                salesForm.reset();
                const priceEl = document.getElementById('price');
                if (priceEl) priceEl.value = '';
                const lc = document.getElementById('layananCount');
                if (lc) lc.textContent = '0';
                
                showToast("Tersimpan Offline! Akan dikirim saat online.", 'warning');
                renderOfflineBanner();
                
                setTimeout(() => {
                    const btn = salesForm.querySelector('button[type=submit]');
                    if(btn && btn.dataset.orig){
                        btn.disabled = false;
                        btn.innerHTML = btn.dataset.orig;
                    }
                }, 100);
            }
        });
    }
});
</script>
