<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>POS Cuci Kendaraan</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .navbar-brand { font-weight: bold; }
        body { background-color: #f8f9fa; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">WashPOS</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <% if (typeof user !== 'undefined' && user) { %>
                <ul class="navbar-nav me-auto">
                    <% if (user.role === 'owner') { %>
                        <li class="nav-item"><a class="nav-link" href="/">Dashboard</a></li>
                    <% } %>
                    <% if (user.role === 'owner' || user.role === 'admin') { %>
                        <li class="nav-item"><a class="nav-link" href="/sales">Penjualan</a></li>
                        <li class="nav-item"><a class="nav-link" href="/expenses">Pengeluaran</a></li>
                        <li class="nav-item"><a class="nav-link" href="/inventory">Stok</a></li>
                        <li class="nav-item"><a class="nav-link" href="/komisi">Komisi Pencuci</a></li>
                    <% } %>
                    <li class="nav-item"><a class="nav-link" href="/absen">Absen</a></li>
                    <% if (user.role === 'owner') { %>
                        <li class="nav-item"><a class="nav-link" href="/master">Master</a></li>
                        <li class="nav-item"><a class="nav-link" href="/akun">Akun</a></li>
                        <li class="nav-item"><a class="nav-link" href="/reports">Laporan</a></li>
                    <% } %>
                </ul>
                <div class="d-flex align-items-center text-white gap-2">
                    <span>Halo, <strong><%= user.username %></strong> (<%= user.role %>)</span>
                    <% if (typeof loginTime !== 'undefined' && loginTime) { %>
                        <small class="badge bg-light text-dark">Login: <%= new Date(loginTime).toLocaleString('id-ID', {hour:'2-digit', minute:'2-digit', timeZone:'Asia/Makassar'}) %> • <%= new Date(loginTime).toLocaleDateString('id-ID', {timeZone:'Asia/Makassar'}) %></small>
                    <% } %>
                    <% if (user.role==='owner') { %><a href="/karyawan-aktif" class="btn btn-sm btn-warning">Karyawan Aktif</a><% } %>
                    <a href="/logout" class="btn btn-sm btn-danger">Logout</a>
                </div>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <%- body %>
    </div>

    <% if (typeof user !== 'undefined' && user && (user.role === 'owner' || user.role === 'admin')) { %>
    <!-- Modal Rekap Kasir & Kirim Laporan ke Telegram -->
    <div class="modal fade" id="modalTelegramReport" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-info text-dark">
                    <h5 class="modal-title">✈️ Rekap Kasir & Kirim ke Telegram</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">
                        Kirim ringkasan omset tunai & QRIS, pengeluaran, serta komisi pencuci hari ini langsung ke Telegram Anda.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tanggal Laporan</label>
                        <input type="date" id="telegramReportDate" class="form-control form-control-sm" value="<%= new Date().toISOString().slice(0, 10) %>">
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="telegramIncludeDb" checked>
                        <label class="form-check-label small" for="telegramIncludeDb">
                            <strong>Lampirkan Berkas Cadangan Database (<code>pos.db</code>)</strong><br>
                            <span class="text-muted">Mengirimkan file fisik pos.db asli sebagai dokumen lampiran yang dapat langsung di-download di chat Telegram.</span>
                        </label>
                    </div>
                    <div id="telegramStatusMsg" class="alert d-none py-2 small mb-0"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                    <button type="button" class="btn btn-primary btn-sm" id="btnSubmitTelegram" onclick="sendTelegramReportFromModal()">
                        🚀 Kirim Sekarang
                    </button>
                </div>
            </div>
        </div>
    </div>
    <script>
    async function sendTelegramReportFromModal() {
        const btn = document.getElementById('btnSubmitTelegram');
        const msgEl = document.getElementById('telegramStatusMsg');
        const date = document.getElementById('telegramReportDate').value;
        const includeDb = document.getElementById('telegramIncludeDb').checked;

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Mengirim ke Telegram...';
        msgEl.className = 'alert alert-info py-2 small';
        msgEl.textContent = 'Menghitung transaksi & mengirim dokumen ke Telegram...';
        msgEl.classList.remove('d-none');

        try {
            const res = await fetch('/api/telegram/send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ date, includeDb })
            });
            const data = await res.json();
            if (data.success) {
                msgEl.className = 'alert alert-success py-2 small';
                msgEl.textContent = '✅ ' + data.message;
                if (typeof showToast === 'function') showToast(data.message, 'success');
                setTimeout(() => {
                    const modalEl = document.getElementById('modalTelegramReport');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    msgEl.classList.add('d-none');
                }, 2000);
            } else {
                msgEl.className = 'alert alert-danger py-2 small';
                msgEl.textContent = '❌ ' + (data.message || 'Gagal mengirim laporan.');
            }
        } catch (err) {
            msgEl.className = 'alert alert-danger py-2 small';
            msgEl.textContent = '❌ Terjadi kesalahan jaringan: ' + err.message;
        } finally {
            btn.disabled = false;
            btn.innerHTML = '🚀 Kirim Sekarang';
        }
    }
    </script>
    <% } %>
    <!-- Toast container 7.1 -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080">
        <div id="appToast" class="toast align-items-center text-bg-success border-0" role="alert"><div class="d-flex"><div class="toast-body" id="toastMsg">Berhasil</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>
    </div>

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0d6efd">
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        if('serviceWorker' in navigator){ navigator.serviceWorker.register('/sw.js').catch(()=>{}); }
    </script>
    <script>
        function showToast(msg, type='success'){
            const t=document.getElementById('appToast');
            const m=document.getElementById('toastMsg');
            if(m) m.textContent=msg;
            t.className='toast align-items-center text-bg-'+type+' border-0';
            new bootstrap.Toast(t, {delay:3000}).show();
        }
        // loading state untuk semua form submit
        document.addEventListener('DOMContentLoaded', ()=>{
            document.querySelectorAll('form').forEach(f=>{
                f.addEventListener('submit', ()=>{
                    const btn=f.querySelector('button[type=submit]');
                    if(btn){ btn.dataset.orig=btn.innerHTML; btn.innerHTML='<span class="spinner-border spinner-border-sm"></span> Memproses...'; btn.disabled=true; setTimeout(()=>{btn.disabled=false; btn.innerHTML=btn.dataset.orig;}, 4000); }
                });
            });
            // empty state sudah di tiap view, toast untuk flash
            const urlParams=new URLSearchParams(window.location.search);
            if(urlParams.get('success')) showToast(urlParams.get('success'));
            if(urlParams.get('error')) showToast(urlParams.get('error'),'danger');
        });
    </script>
    <script>
        // Rupiah helper: format 15000 -> "15.000" (mendukung 0)
        function formatRupiah(angka) {
            if(angka === 0 || angka === '0') return '0';
            if(!angka) return '';
            const digits = String(angka).replace(/[^0-9]/g,'');
            if(!digits) return '';
            return digits.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }
        function parseRupiah(str) {
            if(str === 0 || str === '0') return 0;
            if(!str) return NaN;
            const d = String(str).replace(/[^0-9]/g,'');
            return d ? parseInt(d,10) : NaN;
        }
        // Auto-fetch harga & format
        function updatePrice() {
            const el = document.getElementById('service_name');
            const priceEl = document.getElementById('price');
            if(el && priceEl && el.value) {
                fetch('/api/service-price?name=' + encodeURIComponent(el.value))
                    .then(res => res.json())
                    .then(data => {
                        priceEl.value = formatRupiah(data.price);
                    });
            }
        }
        // Apply live formatting to all .rupiah inputs
        document.addEventListener('DOMContentLoaded', function(){
            document.querySelectorAll('.rupiah').forEach(function(inp){
                // format initial value
                if(inp.value) inp.value = formatRupiah(inp.value);
                inp.addEventListener('input', function(e){
                    const pos = e.target.selectionStart;
                    const beforeLen = e.target.value.length;
                    e.target.value = formatRupiah(e.target.value);
                    const afterLen = e.target.value.length;
                    // keep cursor near end (simple)
                    try { e.target.setSelectionRange(e.target.selectionStart + (afterLen-beforeLen), e.target.selectionStart + (afterLen-beforeLen)); } catch {}
                });
                // on submit, strip formatting? server handles, but keep as is
            });
        });
        // Validasi umum sebelum submit (dipanggil via onsubmit)
        function validateRupiahForm(form) {
            const rupiahInputs = form.querySelectorAll('.rupiah');
            for(const inp of rupiahInputs){
                const v = parseRupiah(inp.value);
                const allowZero = inp.name === 'commission' || inp.getAttribute('data-allow-zero') === 'true';
                if(allowZero && (v === 0 || inp.value.trim() === '0')){
                    continue;
                }
                if(isNaN(v) || v < 1000){
                    alert('Validasi gagal: Harga/Nominal harus angka ≥ 1.000 (contoh: 15.000). Nilai sekarang: ' + inp.value);
                    inp.focus();
                    return false;
                }
            }
            // cek nama min 2 karakter untuk input text required
            const textInputs = form.querySelectorAll('input[type="text"][required]');
            for(const inp of textInputs){
                if(inp.value.trim().length < 2){
                    alert('Validasi gagal: '+ (inp.placeholder || inp.name || 'Field') +' minimal 2 karakter.');
                    inp.focus();
                    return false;
                }
            }
            return true;
        }
    </script>
</body>
</html>

