<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Struk Pembayaran - <%= (typeof shopSettings !== 'undefined' && shopSettings.shop_name) ? shopSettings.shop_name : 'Prime Motowash' %></title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <style>
        body { font-family: 'Courier New', Courier, monospace; font-size: 13px; max-width: 320px; margin: 0 auto; padding: 15px; color: #111; }
        .text-center { text-align: center; }
        .bold { font-weight: bold; }
        hr { border-top: 1px dashed #000; border-bottom: none; margin: 8px 0; }
        .row { display: flex; justify-content: space-between; margin-bottom: 4px; }
        .receipt-logo { max-width: 150px; max-height: 75px; object-fit: contain; margin-bottom: 6px; filter: grayscale(100%) contrast(200%); -webkit-filter: grayscale(100%) contrast(200%); }
        .btn-action { display: block; width: 100%; padding: 10px 14px; border: none; border-radius: 6px; font-weight: bold; font-family: sans-serif; font-size: 13px; cursor: pointer; margin-bottom: 8px; text-decoration: none; text-align: center; box-sizing: border-box; }
        .btn-print-sys { background: #0d6efd; color: #fff; }
        .btn-print-bt { background: #0b5ed7; color: #fff; border: 1px solid #084298; }
        .btn-print-rawbt { background: #6f42c1; color: #fff; }
        .btn-wa { background: #25D366; color: #fff; }
        .btn-back { background: #f8f9fa; color: #495057; border: 1px solid #ced4da; }
        .modal-help { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 9999; align-items: center; justify-content: center; font-family: sans-serif; }
        .modal-help-content { background: #fff; max-width: 380px; margin: 20px; padding: 20px; border-radius: 8px; font-size: 12px; line-height: 1.5; color: #333; text-align: left; }
        @media print {
            body { padding: 0; margin: 0; width: 100%; max-width: 100%; }
            .no-print { display: none !important; }
            .receipt-logo { filter: grayscale(100%) contrast(250%) !important; -webkit-filter: grayscale(100%) contrast(250%) !important; }
        }
    </style>
</head>
<body>
    <div class="text-center" id="receiptPrintArea">
        <% if (typeof shopSettings === 'undefined' || !shopSettings || shopSettings.receipt_show_logo !== '0') { %>
            <img src="/img/logo-thermal.png" id="receiptLogoImg" alt="Logo" class="receipt-logo" crossorigin="anonymous" onerror="this.src='/img/logo.png'">
        <% } %>
        <h2 style="margin: 0; font-size: 18px; font-weight: bold; letter-spacing: 0.5px; text-transform: uppercase;">
            <%= (typeof shopSettings !== 'undefined' && shopSettings.shop_name) ? shopSettings.shop_name : 'Prime Motowash' %>
        </h2>
        <% if (typeof shopSettings !== 'undefined' && shopSettings.shop_slogan && shopSettings.shop_slogan.trim() && !shopSettings.shop_slogan.includes('Professional Motor')) { %>
            <p style="margin: 2px 0; font-size: 11px; font-style: italic;"><%= shopSettings.shop_slogan %></p>
        <% } %>
        <% if (typeof shopSettings !== 'undefined' && shopSettings.shop_address) { %>
            <p style="margin: 2px 0; font-size: 11px;"><%= shopSettings.shop_address %></p>
        <% } %>
        <% if (typeof shopSettings !== 'undefined' && shopSettings.shop_phone) { %>
            <p style="margin: 2px 0; font-size: 11px;">WA / Telp: <%= shopSettings.shop_phone %></p>
        <% } %>
        <p style="margin: 6px 0 2px 0; font-size: 11px; font-weight: bold; letter-spacing: 1px;">STRUK BUKTI PEMBAYARAN</p>
        <hr>
        <div class="row"><span>Waktu:</span> <span><%= new Date(sale.date).toLocaleString('id-ID', { timeZone: 'Asia/Makassar', year:'numeric', month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit' }) %></span></div>
        <div class="row"><span>No. Nota:</span> <span class="bold"><%= (typeof receiptNumber !== 'undefined') ? receiptNumber : ('#' + String(sale.id).padStart(4, '0')) %></span></div>
        <hr>
        <div class="row"><span>Pelanggan:</span> <span><%= sale.customer_name %></span></div>
        <div class="row"><span>Plat Nomor:</span> <span class="bold"><%= sale.license_plate %></span></div>
        <div class="row"><span>Pencuci:</span> <span><%= sale.worker_name %></span></div>
        <hr>
        <div style="margin-bottom:6px;">
            <div style="display:flex; justify-content:space-between; font-weight:bold; border-bottom:1px solid #000; padding-bottom:3px; margin-bottom:4px;">
                <span>Rincian Layanan</span><span>Biaya</span>
            </div>
            <% if (typeof serviceItems !== 'undefined' && serviceItems && serviceItems.length > 0) { %>
                <% serviceItems.forEach(item => { %>
                    <div class="row">
                        <span>- <%= item.name %></span>
                        <span><%= item.price ? ('Rp ' + Number(item.price).toLocaleString('id-ID')) : '-' %></span>
                    </div>
                <% }) %>
            <% } else { %>
                <% (sale.service_name||'').split(',').forEach(lay => { %>
                    <div class="row"><span>- <%= lay.trim() %></span></div>
                <% }) %>
            <% } %>
        </div>
        <hr>
        <div class="row bold" style="font-size: 14px;"><span>Total Tagihan:</span> <span>Rp <%= sale.price.toLocaleString('id-ID') %></span></div>
        <div class="row"><span>Metode Bayar:</span> <span><%= sale.akun_kas || 'Kas Kecil (Tunai)' %></span></div>
        <hr>
        <div class="row"><span>Kasir:</span> <span><%= sale.admin_name %></span></div>
        
        <div class="text-center" style="margin-top:14px;">
            <p style="margin: 0; font-weight: bold; font-size: 12px;">
                <%= ((typeof shopSettings !== 'undefined' && shopSettings.receipt_footer) ? shopSettings.receipt_footer : 'Terima kasih atas kunjungan Anda').replace(/!+$/, '').trim() %>
            </p>
            <% if (typeof shopSettings !== 'undefined' && shopSettings.receipt_feedback && shopSettings.receipt_feedback.trim()) { %>
                <p style="margin: 4px 0 0 0; font-size: 11px; color: #222; line-height: 1.3;">
                    <%= shopSettings.receipt_feedback %>
                </p>
            <% } %>
            <p style="margin: 4px 0 0 0; font-size: 10px; color: #555;">Simpan sebagai bukti transaksi resmi</p>

            <% if (typeof shopSettings === 'undefined' || !shopSettings || shopSettings.receipt_show_qr !== '0') { %>
                <div style="margin-top:10px;">
                    <img id="receiptQrImg" src="https://api.qrserver.com/v1/create-qr-code/?size=130x130&margin=2&data=<%= encodeURIComponent('https://washpos.onrender.com/receipt/' + sale.id) %>" alt="QR Code Struk" style="margin-bottom:2px; width:95px; height:95px;" crossorigin="anonymous">
                    <p style="margin: 2px 0 0 0; font-size: 9px; color: #666;">Scan QR untuk nota digital online</p>
                </div>
            <% } %>
        </div>
    </div>
    
    <!-- TOMBOL AKSI CETAK & BLUETOOTH -->
    <div class="text-center no-print" style="margin-top:25px;">
        <% if (typeof isPreview !== 'undefined' && isPreview) { %>
            <div style="background:#e9f5ff; border:1px solid #b6d4fe; border-radius:5px; padding:8px; margin-bottom:12px; font-size:12px; color:#084298;">
                ℹ️ <strong>Mode Pratinjau Desain Struk</strong><br>Ini adalah simulasi hasil cetak struk thermal kasir.
            </div>
        <% } %>

        <!-- OPSI 1: CETAK BLUETOOTH (LENGKAP: LOGO + DATA + QR CODE) -->
        <button type="button" onclick="printBluetoothDirect()" id="btnBluetoothPrint" class="btn-action btn-print-bt">
            🔵 Hubungkan & Cetak Printer Bluetooth
        </button>

        <!-- OPSI 2: CETAK SISTEM / USB / DRIVER WINDOWS -->
        <button onclick="window.print()" class="btn-action btn-print-sys">
            🖨️ Cetak Struk (Sistem / USB / Driver)
        </button>

        <!-- OPSI 3: CETAK RAWBT (ANDROID) -->
        <a href="#" onclick="printViaRawBt(); return false;" class="btn-action btn-print-rawbt">
            📱 Cetak via RawBT (Android POS)
        </a>

        <!-- PETUNJUK KONEKSI BLUETOOTH -->
        <div style="margin-bottom: 12px;">
            <a href="javascript:void(0)" onclick="openHelpModal()" style="font-family: sans-serif; font-size: 11px; color: #0d6efd; text-decoration: underline;">
                ❓ Cara menghubungkan printer Bluetooth
            </a>
        </div>

        <% if (sale.phone && sale.phone.length > 5) { 
            let waNum = sale.phone.replace(/^0/, '62').replace(/[^0-9]/g, '');
            let brand = (typeof shopSettings !== 'undefined' && shopSettings.shop_name) ? shopSettings.shop_name : 'Prime Motowash';
            let waText = encodeURIComponent(`Halo ${sale.customer_name},\n\nKendaraan plat *${sale.license_plate}* Anda sudah selesai dicuci di *${brand}*.\nTotal tagihan: Rp ${sale.price.toLocaleString('id-ID')}.\n\nTerima kasih atas kunjungan Anda!`);
        %>
            <a href="https://wa.me/<%= waNum %>?text=<%= waText %>" target="_blank" class="btn-action btn-wa">
                💬 Kirim Notif WhatsApp
            </a>
        <% } %>

        <a href="/sales" class="btn-action btn-back">
            ⬅️ Kembali ke Kasir
        </a>
    </div>

    <!-- MODAL PETUNJUK -->
    <div id="helpModal" class="modal-help" onclick="if(event.target===this) closeHelpModal()">
        <div class="modal-help-content">
            <h3 style="margin-top:0; font-size:15px; border-bottom:1px solid #ddd; padding-bottom:8px;">Petunjuk Printer Bluetooth</h3>
            <p><strong>1. Tombol "🔵 Hubungkan & Cetak Bluetooth":</strong><br>
            Cukup klik tombol biru di atas pada browser Google Chrome/Edge, lalu pilih nama printer Anda (misal: <em>RPP02N, MPT-II, POS-58</em>). Logo, rincian biaya, dan kode QR akan langsung tercetak!</p>

            <p><strong>2. Menghubungkan di Windows (Laptop):</strong><br>
            Buka <strong>Windows Settings > Bluetooth & devices > Add device</strong>, sambungkan printer (PIN default: <code>0000</code> atau <code>1234</code>).</p>

            <p><strong>3. Di HP Android:</strong><br>
            Gunakan tombol <strong>Cetak via RawBT</strong> jika menggunakan aplikasi RawBT di Android.</p>

            <button onclick="closeHelpModal()" style="width:100%; padding:8px; background:#0d6efd; color:#fff; border:none; border-radius:4px; font-weight:bold; cursor:pointer; margin-top:10px;">Tutup</button>
        </div>
    </div>

    <!-- JAVASCRIPT ESC/POS: LOGO GRAPHIC + TEXT + QR CODE -->
    <script>
        function openHelpModal() {
            document.getElementById('helpModal').style.display = 'flex';
        }
        function closeHelpModal() {
            document.getElementById('helpModal').style.display = 'none';
        }

        // Konversi Gambar (Logo / QR) ke ESC/POS Raster Bit Image (GS v 0)
        function convertImgToEscPos(imgEl, maxWidth = 320) {
            if (!imgEl || !imgEl.complete || !imgEl.naturalWidth) {
                return new Uint8Array(0);
            }
            try {
                let w = imgEl.naturalWidth || imgEl.width;
                let h = imgEl.naturalHeight || imgEl.height;
                if (w > maxWidth) {
                    h = Math.round(h * (maxWidth / w));
                    w = maxWidth;
                }
                // Lebar kelipatan 8 bit (1 byte)
                w = Math.floor(w / 8) * 8;
                if (w < 8) w = 8;

                const canvas = document.createElement('canvas');
                canvas.width = w;
                canvas.height = h;
                const ctx = canvas.getContext('2d');
                ctx.fillStyle = '#FFFFFF';
                ctx.fillRect(0, 0, w, h);
                ctx.drawImage(imgEl, 0, 0, w, h);

                const imgData = ctx.getImageData(0, 0, w, h).data;
                const bytesWidth = w / 8;
                const raster = [];

                // Align center: ESC a 1
                raster.push(0x1B, 0x61, 0x01);
                // GS v 0 0 xL xH yL yH
                const xL = bytesWidth % 256;
                const xH = Math.floor(bytesWidth / 256);
                const yL = h % 256;
                const yH = Math.floor(h / 256);
                raster.push(0x1D, 0x76, 0x30, 0x00, xL, xH, yL, yH);

                for (let y = 0; y < h; y++) {
                    for (let b = 0; b < bytesWidth; b++) {
                        let byte = 0;
                        for (let bit = 0; bit < 8; bit++) {
                            const x = b * 8 + bit;
                            const idx = (y * w + x) * 4;
                            const r = imgData[idx];
                            const g = imgData[idx + 1];
                            const bVal = imgData[idx + 2];
                            const a = imgData[idx + 3];

                            const lum = 0.299 * r + 0.587 * g + 0.114 * bVal;
                            const isBlack = (a > 64) && (lum < 165);
                            if (isBlack) {
                                byte |= (1 << (7 - bit));
                            }
                        }
                        raster.push(byte);
                    }
                }
                raster.push(0x0A); // Newline
                return new Uint8Array(raster);
            } catch (e) {
                console.warn("Gagal konversi raster:", e);
                return new Uint8Array(0);
            }
        }

        // Susun Seluruh Paket Cetak (Logo + Teks Bersih + QR Code)
        function buildCompleteReceiptPayload() {
            const parts = [];

            // 1. Reset Printer: ESC @
            parts.push(new Uint8Array([0x1B, 0x40]));

            // 2. Tambahkan Logo Gambar (jika aktif & ada)
            const logoEl = document.getElementById('receiptLogoImg');
            if (logoEl) {
                const logoRaster = convertImgToEscPos(logoEl, 280);
                if (logoRaster.length > 0) {
                    parts.push(logoRaster);
                }
            }

            // 3. Teks Header
            const shopName = "<%= (typeof shopSettings !== 'undefined' && shopSettings.shop_name) ? shopSettings.shop_name : 'Prime Motowash' %>";
            const shopAddress = "<%= (typeof shopSettings !== 'undefined' && shopSettings.shop_address) ? shopSettings.shop_address : '' %>";
            const shopPhone = "<%= (typeof shopSettings !== 'undefined' && shopSettings.shop_phone) ? shopSettings.shop_phone : '' %>";
            const dateStr = "<%= new Date(sale.date).toLocaleString('id-ID', { timeZone: 'Asia/Makassar', year:'numeric', month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit' }) %>";
            const footer = "<%= ((typeof shopSettings !== 'undefined' && shopSettings.receipt_footer) ? shopSettings.receipt_footer : 'Terima kasih atas kunjungan Anda').replace(/!+$/, '').trim() %>";
            const feedback = "<%= (typeof shopSettings !== 'undefined' && shopSettings.receipt_feedback) ? shopSettings.receipt_feedback : 'Jika ada saran dan kritik silahkan hubungi 082187777080' %>";
            const receiptNum = "<%= (typeof receiptNumber !== 'undefined') ? receiptNumber : ('#' + String(sale.id).padStart(4, '0')) %>";

            let headerTxt = "";
            headerTxt += "\x1B\x61\x01"; // Center align
            headerTxt += "\x1B\x21\x20" + shopName + "\x1B\x21\x00\n"; // Double height font
            if (shopAddress) headerTxt += shopAddress + "\n";
            if (shopPhone) headerTxt += "Telp/WA: " + shopPhone + "\n";
            headerTxt += "STRUK BUKTI PEMBAYARAN\n";
            headerTxt += "--------------------------------\n";
            headerTxt += "\x1B\x61\x00"; // Left align
            headerTxt += "Waktu   : " + dateStr + "\n";
            headerTxt += "No. Nota: " + receiptNum + "\n";
            headerTxt += "Plat    : <%= sale.license_plate %>\n";
            headerTxt += "Plgn    : <%= sale.customer_name %>\n";
            headerTxt += "Pencuci : <%= sale.worker_name %>\n";
            headerTxt += "--------------------------------\n";
            headerTxt += "Layanan:\n";
            <% if (typeof serviceItems !== 'undefined' && serviceItems && serviceItems.length > 0) { %>
                <% serviceItems.forEach(item => { %>
                    {
                        const name = "- " + "<%= item.name %>";
                        const pr = "<%= item.price ? Number(item.price).toLocaleString('id-ID') : '' %>";
                        if (pr) {
                            const spaces = Math.max(1, 32 - name.length - pr.length);
                            headerTxt += name + " ".repeat(spaces) + pr + "\n";
                        } else {
                            headerTxt += name + "\n";
                        }
                    }
                <% }) %>
            <% } else { %>
                <% (sale.service_name||'').split(',').forEach(lay => { %>
                    headerTxt += " - <%= lay.trim() %>\n";
                <% }) %>
            <% } %>
            headerTxt += "--------------------------------\n";
            headerTxt += "\x1B\x21\x08Total   : Rp <%= sale.price.toLocaleString('id-ID') %>\x1B\x21\x00\n"; // Bold
            headerTxt += "Bayar   : <%= sale.akun_kas || 'Kas Kecil (Tunai)' %>\n";
            headerTxt += "Kasir   : <%= sale.admin_name %>\n";
            headerTxt += "--------------------------------\n";
            headerTxt += "\x1B\x61\x01"; // Center align
            headerTxt += footer + "\n";
            if (feedback && feedback.trim()) {
                const words = feedback.trim().split(/\s+/);
                let curLine = "";
                words.forEach(w => {
                    if ((curLine + (curLine ? " " : "") + w).length <= 32) {
                        curLine += (curLine ? " " : "") + w;
                    } else {
                        if (curLine) headerTxt += curLine + "\n";
                        curLine = w;
                    }
                });
                if (curLine) headerTxt += curLine + "\n";
            }
            headerTxt += "Simpan sebagai bukti transaksi\n";

            parts.push(new TextEncoder().encode(headerTxt));

            // 4. Tambahkan Gambar Barcode / QR Code (jika aktif)
            const qrEl = document.getElementById('receiptQrImg');
            if (qrEl) {
                const qrRaster = convertImgToEscPos(qrEl, 120);
                if (qrRaster.length > 0) {
                    parts.push(new TextEncoder().encode("\n"));
                    parts.push(qrRaster);
                    parts.push(new TextEncoder().encode("[ Nota Digital Online ]\n"));
                }
            }

            // 5. Feed kertas hemat (hanya 2 baris agar pas di gerigi sobek tanpa membuang kertas)
            parts.push(new TextEncoder().encode("\n\n"));

            // Gabungkan semua part menjadi 1 Uint8Array tunggal
            let totalLen = 0;
            parts.forEach(p => totalLen += p.length);
            const combined = new Uint8Array(totalLen);
            let offset = 0;
            parts.forEach(p => {
                combined.set(p, offset);
                offset += p.length;
            });

            return combined;
        }

        // Cetak Langsung via Web Bluetooth
        async function printBluetoothDirect() {
            if (!navigator.bluetooth) {
                alert("Browser ini belum mendukung Web Bluetooth secara langsung.\n\nGunakan Google Chrome atau Microsoft Edge versi terbaru, atau gunakan tombol 'Cetak via RawBT' jika dari HP Android.");
                openHelpModal();
                return;
            }

            const btn = document.getElementById('btnBluetoothPrint');
            const origText = btn.innerHTML;
            btn.innerHTML = "⏳ Menghubungkan Printer...";
            btn.disabled = true;

            try {
                const device = await navigator.bluetooth.requestDevice({
                    acceptAllDevices: true,
                    optionalServices: [
                        '000018f0-0000-1000-8000-00805f9b34fb',
                        'e7810a71-73ae-499d-8c15-faa9aef0c3f2',
                        '49535343-fe7d-4ae5-8fa9-9fafd205e455',
                        '0000ff00-0000-1000-8000-00805f9b34fb',
                        '0000af30-0000-1000-8000-00805f9b34fb'
                    ]
                });

                btn.innerHTML = "⏳ Menyambung ke " + device.name + "...";
                const server = await device.gatt.connect();

                const services = await server.getPrimaryServices();
                let writeChar = null;

                for (const svc of services) {
                    try {
                        const chars = await svc.getCharacteristics();
                        for (const ch of chars) {
                            if (ch.properties.write || ch.properties.writeWithoutResponse) {
                                writeChar = ch;
                                break;
                            }
                        }
                    } catch (e) {}
                    if (writeChar) break;
                }

                if (!writeChar) {
                    throw new Error("Saluran tulis Bluetooth tidak ditemukan pada printer ini.");
                }

                btn.innerHTML = "⏳ Mengirim Logo & Struk...";

                const payload = buildCompleteReceiptPayload();

                // Kirim data bertahap per 512 byte agar tidak macet di printer
                const chunkSize = 512;
                for (let i = 0; i < payload.length; i += chunkSize) {
                    const chunk = payload.slice(i, i + chunkSize);
                    if (writeChar.properties.write) {
                        await writeChar.writeValueWithResponse(chunk);
                    } else {
                        await writeChar.writeValueWithoutResponse(chunk);
                    }
                }

                btn.innerHTML = "✅ Berhasil Dicetak!";
                setTimeout(() => {
                    btn.innerHTML = origText;
                    btn.disabled = false;
                    try { device.gatt.disconnect(); } catch (e) {}
                }, 3000);

            } catch (err) {
                console.error("Bluetooth error:", err);
                if (err.name !== 'NotFoundError') {
                    alert("Gagal mencetak Bluetooth: " + err.message);
                }
                btn.innerHTML = origText;
                btn.disabled = false;
            }
        }

        // Cetak via RawBT (Android)
        function printViaRawBt() {
            const payload = buildCompleteReceiptPayload();
            let binary = '';
            const len = payload.byteLength;
            for (let i = 0; i < len; i++) {
                binary += String.fromCharCode(payload[i]);
            }
            const base64Data = btoa(binary);
            window.location.href = "rawbt:data:base64," + base64Data;

            setTimeout(() => {
                const conf = confirm("Apakah printer sudah mencetak?\n\nJika belum, pastikan Anda telah memasang aplikasi gratis 'RawBT Print Service' dari Google Play Store pada HP/Tablet ini.");
                if (!conf) {
                    window.open("https://play.google.com/store/apps/details?id=ru.a402d.rawbtprinter", "_blank");
                }
            }, 3000);
        }
    </script>
</body>
</html>
