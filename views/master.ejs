<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Master Data <small class="text-muted fs-6">(Owner Only)</small></h2>
</div>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger"><%= error %></div>
<% } %>
<% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><%= success %></div>
<% } %>

<div class="row">
    <!-- KELOLA KARYAWAN -->
    <div class="col-md-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <span>Karyawan & Staf (Pencuci & Admin)</span>
                <span class="badge bg-light text-dark"><%= workers.length %> orang</span>
            </div>
            <div class="card-body">
                <form action="/master/workers/add" method="POST" class="mb-4" onsubmit="return validateRupiahForm(this)">
                    <label class="form-label fw-bold">Tambah Karyawan / Admin Baru</label>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6 col-12">
                            <label class="form-label small text-muted mb-1">Nama Karyawan / Admin <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control form-control-sm" placeholder="Nama..." required minlength="2" maxlength="50">
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label small text-muted mb-1">Posisi / Jabatan</label>
                            <select name="role" class="form-select form-select-sm">
                                <option value="Pencuci" selected>Pencuci Motor</option>
                                <option value="Admin">Admin / Kasir</option>
                            </select>
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label small text-muted mb-1">Tanggal Masuk</label>
                            <input type="date" name="join_date" class="form-control form-control-sm" title="Tanggal Masuk" value="<%= new Date().toISOString().slice(0,10) %>">
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label small text-muted mb-1">Tarif Gaji Pokok Harian (Rp)</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light fw-bold">Rp</span>
                                <input type="text" name="daily_salary" class="form-control rupiah-input" placeholder="0 (Owner tentukan)">
                            </div>
                            <small class="text-muted" style="font-size: 11px;">Gaji pokok per hari kehadiran (absen masuk).</small>
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label small text-muted mb-1">🎁 Bonus Kerajinan / Masuk Full (Rp)</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-warning bg-opacity-25 fw-bold">Rp</span>
                                <input type="text" name="bonus_rajin" class="form-control rupiah-input" value="<%= (typeof fullAttendanceBonus !== 'undefined') ? fullAttendanceBonus.toLocaleString('id-ID') : '150.000' %>" placeholder="150.000">
                            </div>
                            <small class="text-muted" style="font-size: 11px;">Bonus otomatis jika masuk memenuhi target (luar off mingguan).</small>
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label small text-muted mb-1">No WhatsApp (Opsional)</label>
                            <input type="text" name="phone" class="form-control form-control-sm" placeholder="08xxxxxxxxxx">
                            <small class="text-muted" style="font-size: 11px;">Untuk kirim rincian slip gaji via WA.</small>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" role="switch" id="addWorkerBonusEnabled" name="bonus_enabled" value="1">
                                <label class="form-check-label small fw-bold" for="addWorkerBonusEnabled">Aktifkan Bonus Masuk Full untuk karyawan ini</label>
                                <small class="d-block text-muted" style="font-size: 11px;">Biarkan mati (Nonaktif) jika karyawan baru belum genap bekerja 1 bulan.</small>
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-success btn-sm w-100" type="submit">+ Tambah Karyawan / Admin</button>
                    <small class="text-muted d-block mt-1">Owner dapat menentukan sendiri tarif gaji harian tiap karyawan & staf admin.</small>
                </form>
                <hr>
                <h6>Daftar Karyawan & Staf</h6>
                <div class="table-responsive" style="max-height:300px; overflow-y:auto;">
                    <table class="table table-sm table-hover mb-0 align-middle">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>#</th>
                                <th>Nama</th>
                                <th>Posisi</th>
                                <th>Tgl Masuk</th>
                                <th class="text-end">Tarif Harian</th>
                                <th class="text-end">Bonus Rajin</th>
                                <th>No WA</th>
                                <th class="text-end">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (workers.length === 0) { %>
                                <tr><td colspan="8" class="text-center text-muted">Belum ada karyawan/staf.</td></tr>
                            <% } %>
                            <% workers.forEach((w, i) => { %>
                            <tr>
                                <td><%= i+1 %></td>
                                <td class="fw-bold"><%= w.name %></td>
                                <td>
                                    <% if (w.role === 'Admin') { %>
                                        <span class="badge bg-info text-dark">Admin</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary">Pencuci</span>
                                    <% } %>
                                </td>
                                <td><small class="badge bg-light text-dark border"><%= w.join_date || '-' %></small></td>
                                <td class="text-end fw-bold text-success">
                                    Rp <%= (w.daily_salary || 0).toLocaleString('id-ID') %>
                                </td>
                                <td class="text-end">
                                    <div class="fw-bold text-warning">
                                        Rp <%= (w.bonus_rajin !== undefined && w.bonus_rajin !== null ? w.bonus_rajin : (typeof fullAttendanceBonus !== 'undefined' ? fullAttendanceBonus : 150000)).toLocaleString('id-ID') %>
                                    </div>
                                    <form action="/master/workers/toggle-bonus" method="POST" class="d-inline">
                                        <input type="hidden" name="id" value="<%= w.id %>">
                                        <input type="hidden" name="enabled" value="<%= Number(w.bonus_enabled) === 1 ? '0' : '1' %>">
                                        <button type="submit" class="btn btn-xs <%= Number(w.bonus_enabled) === 1 ? 'btn-success' : 'btn-outline-secondary' %> py-0 px-1 mt-1" style="font-size:10px;" title="Klik untuk ubah status Bonus Masuk Full untuk <%= w.name %>">
                                            <%= Number(w.bonus_enabled) === 1 ? '✅ Aktif' : '⏸️ Nonaktif' %>
                                        </button>
                                    </form>
                                </td>
                                <td><small class="text-muted"><%= w.phone || '-' %></small></td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2" style="font-size:12px;" onclick='openEditWorkerModal(<%= JSON.stringify(w) %>)'>
                                        ✏️ Edit
                                    </button>
                                    <form action="/master/workers/delete" method="POST" class="d-inline" onsubmit="return confirm('Hapus karyawan <%= w.name %>? Data lama tetap tersimpan.')">
                                        <input type="hidden" name="id" value="<%= w.id %>">
                                        <button type="submit" class="btn btn-xs btn-outline-danger py-0 px-2" style="font-size:12px;">Hapus</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- KATEGORI PENGELUARAN -->
    <div class="col-md-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                <span>Kategori Pengeluaran</span>
                <span class="badge bg-light text-dark"><%= expense_categories.length %> kategori</span>
            </div>
            <div class="card-body">
                <form action="/master/expense-categories/add" method="POST" class="mb-4" onsubmit="return validateRupiahForm(this)">
                    <label class="form-label fw-bold">Tambah Kategori Baru</label>
                    <div class="input-group">
                        <input type="text" name="name" class="form-control" placeholder="Misal: Sewa, BBM..." required minlength="2" maxlength="50">
                        <button class="btn btn-warning" type="submit">+ Tambah</button>
                    </div>
                    <small class="text-muted">Validasi: nama unik, 2-50 karakter. Muncul di dropdown Pengeluaran.</small>
                </form>
                <hr>
                <h6>Daftar Kategori</h6>
                <div class="table-responsive" style="max-height:300px; overflow-y:auto;">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light sticky-top"><tr><th>#</th><th>Nama Kategori</th><th class="text-end">Aksi</th></tr></thead>
                        <tbody>
                            <% if (expense_categories.length === 0) { %>
                                <tr><td colspan="3" class="text-center text-muted">Belum ada kategori.</td></tr>
                            <% } %>
                            <% expense_categories.forEach((c, i) => { %>
                            <tr>
                                <td><%= i+1 %></td>
                                <td><span class="badge bg-warning text-dark"><%= c.name %></span></td>
                                <td class="text-end">
                                    <form action="/master/expense-categories/delete" method="POST" class="d-inline" onsubmit="return confirm('Hapus kategori <%= c.name %>?')">
                                        <input type="hidden" name="id" value="<%= c.id %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Hapus</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <div class="alert alert-light py-2 mt-3 mb-0 border">
                    <small><strong>Seed awal:</strong> Sabun, Peralatan, Perlengkapan, Listrik/Air, Gaji, Lainnya.</small>
                </div>
            </div>
        </div>
    </div>

    <!-- INFO VALIDASI -->
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">Ringkasan</div>
            <div class="card-body small">
                <div class="d-flex justify-content-between"><span>Total Layanan</span><strong><%= services.length %></strong></div>
                <div class="d-flex justify-content-between"><span>Total Karyawan</span><strong><%= workers.length %></strong></div>
                <div class="d-flex justify-content-between"><span>Total Kategori Biaya</span><strong><%= expense_categories.length %></strong></div>
                <div class="d-flex justify-content-between"><span>Total Akun Login</span><strong><%= users.length %></strong></div>
                <hr class="my-2">
                <small class="text-muted">Kelola data layanan, karyawan pencuci, dan kategori pengeluaran secara terpusat.</small>
            </div>
        </div>
    </div>
</div>

<!-- KELOLA AKUN PENGGUNA (LOGIN KASIR & OWNER) -->
<div class="card shadow-sm mb-4 border-dark">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <span class="fw-bold">🔐 Kelola Akun Login Kasir & Pengguna</span>
        <span class="badge bg-light text-dark"><%= users.length %> akun</span>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- Form Tambah Akun -->
            <div class="col-md-5 border-end pe-md-4 mb-3 mb-md-0">
                <form action="/master/users/add" method="POST">
                    <label class="form-label fw-bold">Tambah Akun Pengguna Baru</label>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Username (ID Login)</label>
                        <input type="text" name="username" class="form-control" placeholder="contoh: sarah" required minlength="3" maxlength="30" pattern="[a-zA-Z0-9_]+" title="Hanya huruf, angka, dan underscore">
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Password</label>
                        <input type="password" name="password" class="form-control" placeholder="Kata sandi..." required minlength="4">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Hak Akses (Role)</label>
                        <select name="role" class="form-select">
                            <option value="owner">Owner (Akses Penuh Semua Menu & Laporan)</option>
                            <option value="admin" selected>Admin (Akses Terbatas: Kasir, Pengeluaran & Stok)</option>
                            <option value="karyawan">Karyawan (Khusus Absensi Saja)</option>
                        </select>
                    </div>
                    <button class="btn btn-dark w-100" type="submit">+ Buat Akun Baru</button>
                    <small class="text-muted d-block mt-2">Owner = Akses penuh. Admin = Kasir & stok. Karyawan = Khusus absen.</small>
                </form>
            </div>

            <!-- Tabel Daftar Akun -->
            <div class="col-md-7 ps-md-4">
                <h6 class="fw-bold mb-3">Daftar Akun Pengguna Terdaftar</h6>
                <div class="table-responsive" style="max-height: 280px; overflow-y:auto;">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>#</th>
                                <th>Username</th>
                                <th>Role</th>
                                <th class="text-end">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach((u, idx) => { %>
                            <tr>
                                <td><%= idx + 1 %></td>
                                <td class="fw-bold"><%= u.username %></td>
                                <td>
                                    <% if (u.role === 'owner') { %>
                                        <span class="badge bg-primary">Owner</span>
                                    <% } else if (u.role === 'admin') { %>
                                        <span class="badge bg-warning text-dark">Admin</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary">Karyawan</span>
                                    <% } %>
                                </td>
                                <td class="text-end">
                                    <% if (u.username !== 'owner') { %>
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="openRoleModal('<%= u.id %>', '<%= u.username %>', '<%= u.role %>')">
                                        ✏️ Role
                                    </button>
                                    <% } %>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openResetModal('<%= u.id %>', '<%= u.username %>')">
                                        🔑 Sandi
                                    </button>
                                    <% if (u.id !== user.id && u.username !== 'owner') { %>
                                    <form action="/master/users/delete" method="POST" class="d-inline" onsubmit="return confirm('Hapus akun login <%= u.username %>? Pengguna ini tidak akan bisa login lagi.')">
                                        <input type="hidden" name="id" value="<%= u.id %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Hapus</button>
                                    </form>
                                    <% } %>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Ubah Role -->
<div class="modal fade" id="modalUpdateRole" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <form action="/master/users/update-role" method="POST" class="modal-content">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title">Ubah Role: <span id="roleTargetUsername" class="fw-bold"></span></h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" id="roleTargetId">
                <label class="form-label small fw-bold">Pilih Role Baru</label>
                <select name="role" id="roleSelect" class="form-select form-select-sm">
                    <option value="owner">Owner (Akses Penuh)</option>
                    <option value="admin">Admin (Kasir, Pengeluaran & Stok)</option>
                    <option value="karyawan">Karyawan (Khusus Absensi Saja)</option>
                </select>
            </div>
            <div class="modal-footer py-1">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                <button type="submit" class="btn btn-primary btn-sm">Simpan Role</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Reset Password -->
<div class="modal fade" id="modalResetPassword" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <form action="/master/users/reset-password" method="POST" class="modal-content">
            <div class="modal-header bg-dark text-white py-2">
                <h6 class="modal-title">Ganti Sandi: <span id="resetTargetUsername" class="fw-bold"></span></h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" id="resetTargetId">
                <label class="form-label small fw-bold">Kata Sandi Baru</label>
                <input type="password" name="new_password" class="form-control form-control-sm" required minlength="4" placeholder="Min 4 karakter">
            </div>
            <div class="modal-footer py-1">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                <button type="submit" class="btn btn-primary btn-sm">Simpan</button>
            </div>
        </form>
    </div>
</div>

<script>
function openResetModal(id, username) {
    document.getElementById('resetTargetId').value = id;
    document.getElementById('resetTargetUsername').textContent = username;
    new bootstrap.Modal(document.getElementById('modalResetPassword')).show();
}

function openRoleModal(id, username, currentRole) {
    document.getElementById('roleTargetId').value = id;
    document.getElementById('roleTargetUsername').textContent = username;
    document.getElementById('roleSelect').value = currentRole;
    new bootstrap.Modal(document.getElementById('modalUpdateRole')).show();
}
</script>

<!-- MENU LAYANAN FULL WIDTH (tanpa kategori) -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span>Menu / Jenis Layanan</span>
        <span class="badge bg-light text-dark"><%= services.length %> menu</span>
    </div>
    <div class="card-body">
        <form action="/master/services/add" method="POST" class="mb-4" onsubmit="return validateRupiahForm(this)">
            <label class="form-label fw-bold">Tambah Menu Baru <small class="text-muted fw-normal">(nama unik & komisi pencuci, komisi boleh 0)</small></label>
            <div class="row g-2">
                <div class="col-md-5">
                    <input type="text" name="name" class="form-control" placeholder="Nama layanan... (unik, mis: Cuci Helm, Poles)" required minlength="2" maxlength="50">
                </div>
                <div class="col-md-3">
                    <input type="text" name="price" class="form-control rupiah" placeholder="Harga Jual (15.000)" required>
                </div>
                <div class="col-md-2">
                    <input type="text" name="commission" class="form-control rupiah" data-allow-zero="true" placeholder="Komisi Pencuci (0 jika tanpa komisi)" value="0">
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" type="submit">+ Tambah</button>
                </div>
            </div>
            <small class="text-muted">Validasi: nama unik 2-50 karakter, harga jual min 1.000, komisi pencuci boleh 0 jika layanan tanpa komisi.</small>
        </form>

        <hr>

        <h6>Daftar Layanan</h6>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Nama Layanan & Edit</th>
                        <th>Harga Jual</th>
                        <th>Komisi Pencuci</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (services.length === 0) { %>
                        <tr><td colspan="5" class="text-center text-muted">Belum ada layanan.</td></tr>
                    <% } %>
                    <% services.forEach(s => { %>
                    <tr class="<%= s.isActive === 0 ? 'table-secondary opacity-75' : '' %>">
                        <td style="min-width:380px">
                            <form action="/master/services/update" method="POST" class="d-flex gap-1 align-items-center" onsubmit="return validateRupiahForm(this) && confirm('Yakin update layanan <%= s.name %>?')">
                                <input type="hidden" name="id" value="<%= s.id %>">
                                <input type="text" name="name" value="<%= s.name %>" class="form-control form-control-sm" required minlength="2" maxlength="50" style="min-width:160px" title="Nama Layanan">
                                <input type="text" name="price" value="<%= s.price %>" class="form-control form-control-sm rupiah" required style="width:110px" placeholder="Harga" title="Harga Jual">
                                <input type="text" name="commission" value="<%= (typeof s.commission !== 'undefined' && s.commission !== null) ? s.commission : 0 %>" class="form-control form-control-sm rupiah" data-allow-zero="true" style="width:110px" placeholder="Komisi" title="Komisi Pencuci (boleh 0)">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                            </form>
                        </td>
                        <td><span class="fw-bold">Rp <%= s.price.toLocaleString('id-ID') %></span></td>
                        <td><span class="badge <%= (s.commission && s.commission > 0) ? 'bg-success' : 'bg-secondary' %>">Rp <%= (s.commission || 0).toLocaleString('id-ID') %></span></td>
                        <td class="text-center">
                            <% if (s.isActive !== 0) { %>
                                <span class="badge bg-success">Aktif</span>
                            <% } else { %>
                                <span class="badge bg-secondary">Nonaktif</span>
                            <% } %>
                        </td>
                        <td class="text-end">
                            <form action="/master/services/toggle" method="POST" class="d-inline">
                                <input type="hidden" name="id" value="<%= s.id %>">
                                <% if (s.isActive !== 0) { %>
                                    <button type="submit" class="btn btn-sm btn-outline-warning py-1 px-2" style="font-size:12px;" title="Nonaktifkan agar tidak muncul di kasir" onclick="return confirm('Nonaktifkan layanan <%= s.name %>? Layanan ini sementara tidak akan muncul di menu kasir.')">
                                        ⏸️ Nonaktifkan
                                    </button>
                                <% } else { %>
                                    <button type="submit" class="btn btn-sm btn-success py-1 px-2" style="font-size:12px;" title="Aktifkan kembali agar muncul di kasir" onclick="return confirm('Aktifkan kembali layanan <%= s.name %>? Layanan ini akan kembali muncul di menu kasir.')">
                                        ▶️ Aktifkan
                                    </button>
                                <% } %>
                            </form>
                            <form action="/master/services/delete" method="POST" class="d-inline ms-1" onsubmit="return confirm('Hapus permanen layanan <%= s.name %>?')">
                                <input type="hidden" name="id" value="<%= s.id %>">
                                <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size:12px;">Hapus</button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <div class="alert alert-info py-2 mt-3 mb-0">
            <small><strong>Tips:</strong> Atur <strong>Harga Jual</strong> dan <strong>Komisi Pencuci</strong> per layanan. Gunakan tombol <strong>"⏸️ Nonaktifkan"</strong> jika suatu layanan sedang tidak tersedia agar tidak muncul di kasir, tanpa menghapus riwayat laporan transaksi lama.</small>
        </div>
    </div>
</div>

<!-- PENGATURAN DEFAULT BONUS MASUK FULL & KOMISI KONTEN -->
<div class="card shadow-sm mb-4 border-warning">
    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
        <span class="fw-bold">🎁 Pengaturan Tarif Default Bonus Masuk Full &amp; Komisi Konten</span>
        <span class="badge bg-dark text-white">Aktif/Nonaktif Diatur Per Akun Karyawan</span>
    </div>
    <div class="card-body">
        <form action="/master/settings/payroll" method="POST" onsubmit="return validateRupiahForm(this)">
            <div class="alert alert-light border py-2 mb-3 small">
                💡 <strong>Catatan:</strong> Aktif/nonaktifnya Bonus Masuk Full kini diatur <strong>per karyawan (per akun)</strong> lewat tombol status di tabel Karyawan di atas atau langsung di menu <strong>Gaji &amp; Komisi</strong>.
            </div>
            <div class="row align-items-end g-3">
                <div class="col-md-4 col-12">
                    <label class="form-label small fw-bold mb-1">Nominal Bonus Masuk Full Default (Rp)</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light fw-bold">Rp</span>
                        <input type="text" name="full_attendance_bonus" class="form-control rupiah" data-allow-zero="true" value="<%= (typeof fullAttendanceBonus !== 'undefined') ? fullAttendanceBonus.toLocaleString('id-ID') : '150.000' %>" placeholder="150.000" required>
                    </div>
                    <small class="text-muted" style="font-size: 11px;">Tarif bawaan untuk karyawan baru (off 1x/minggu).</small>
                </div>
                <div class="col-md-4 col-12">
                    <label class="form-label small fw-bold mb-1">🎬 Komisi Upload Konten Admin (Rp / Konten)</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light fw-bold">Rp</span>
                        <input type="text" name="admin_content_commission" class="form-control rupiah" data-allow-zero="true" value="<%= (typeof adminContentCommission !== 'undefined') ? adminContentCommission.toLocaleString('id-ID') : '10.000' %>" placeholder="10.000" required>
                    </div>
                    <small class="text-muted" style="font-size: 11px;">Tarif default saat Owner menginput konten Admin di Gaji & Komisi.</small>
                </div>
                <div class="col-md-4 col-12">
                    <button type="submit" class="btn btn-warning fw-bold w-100 py-2">💾 Simpan Pengaturan Gaji & Bonus</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- PROFIL USAHA, LOGO & KUSTOMISASI HEADER / FOOTER STRUK -->
<div class="card shadow-sm mb-4 border-primary">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span class="fw-bold">🏪 Profil Usaha, Logo & Kustomisasi Struk (Header & Footer)</span>
        <span class="badge bg-light text-primary fw-bold">Brand Identity</span>
    </div>
    <div class="card-body">
        <form action="/master/settings/shop" method="POST">
            <div class="row">
                <div class="col-md-4 text-center border-end pe-md-3 mb-3 mb-md-0">
                    <label class="form-label small fw-bold d-block">Logo Terpilih</label>
                    <div class="p-3 bg-light rounded border d-inline-block mb-2 shadow-sm" style="min-width: 170px; min-height: 120px; display: flex; align-items: center; justify-content: center;">
                        <img src="<%= (typeof shopLogo !== 'undefined' && shopLogo) ? shopLogo : '/img/logo.png' %>" id="logoPreviewImg" alt="Logo Usaha" class="img-fluid" style="max-height: 100px; object-fit: contain;">
                    </div>
                    <div class="small text-muted mb-3">Diterapkan pada Navbar, Login, dan Struk Kasir.</div>

                    <label class="form-label small fw-bold d-block text-start">Pilih Varian Logo:</label>
                    <div class="d-flex flex-column gap-2 text-start bg-light p-2 rounded border">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="shop_logo" id="logoOpt1" value="/img/logo.png" <%= (!shopLogo || shopLogo === '/img/logo.png' || shopLogo === '/img/logo-biru.png') ? 'checked' : '' %> onchange="document.getElementById('logoPreviewImg').src=this.value">
                            <label class="form-check-label small" for="logoOpt1">
                                <strong>Background Biru (Utama)</strong>
                                <span class="badge bg-primary d-block mt-1">Senada Tema Navbar &amp; Brand</span>
                            </label>
                        </div>
                        <hr class="my-1">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="shop_logo" id="logoOpt3" value="/img/logo-hitam.png" <%= (shopLogo === '/img/logo-hitam.png') ? 'checked' : '' %> onchange="document.getElementById('logoPreviewImg').src=this.value">
                            <label class="form-check-label small" for="logoOpt3">
                                <strong>Background Hitam</strong>
                                <span class="text-muted d-block small">Nuansa gelap &amp; eksklusif</span>
                            </label>
                        </div>
                    </div>
                    <div class="alert alert-info py-2 px-2 mt-2 mb-0 small text-start">
                        🖨️ <strong>Struk Cetak Thermal:</strong> Otomatis menggunakan logo <strong>Hitam-Putih</strong> kontras tinggi agar cetakan pada kertas thermal tajam, jelas, dan tidak menghabiskan kertas thermal.
                    </div>
                </div>

                <div class="col-md-8 ps-md-4">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Nama Usaha / Outlet <span class="text-danger">*</span></label>
                            <input type="text" name="shop_name" class="form-control form-control-sm fw-bold" value="<%= typeof shopName !== 'undefined' ? shopName : 'Prime Motowash' %>" required placeholder="Contoh: Prime Motowash">
                            <small class="text-muted">Nama brand utama di Header Navbar, Login, dan Struk.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Slogan / Subjudul Usaha</label>
                            <input type="text" name="shop_slogan" class="form-control form-control-sm" value="<%= (typeof shopSlogan !== 'undefined' && !shopSlogan.includes('Professional Motor')) ? shopSlogan : '' %>" placeholder="Opsional (boleh dikosongkan)">
                            <small class="text-muted">Teks pendukung di bawah nama usaha (bisa dikosongkan).</small>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Alamat Outlet</label>
                            <input type="text" name="shop_address" class="form-control form-control-sm" value="<%= typeof shopAddress !== 'undefined' ? shopAddress : '' %>" placeholder="Contoh: Jl. Poros Malino No. 88">
                            <small class="text-muted">Dicetak pada header struk kasir.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">No. Telp / WhatsApp Outlet</label>
                            <input type="text" name="shop_phone" class="form-control form-control-sm" value="<%= typeof shopPhone !== 'undefined' ? shopPhone : '' %>" placeholder="Contoh: 0812-3456-7890">
                            <small class="text-muted">Untuk kontak layanan pelanggan di struk & footer.</small>
                        </div>
                    </div>

                    <hr class="my-3">
                    <h6 class="fw-bold text-primary mb-2">📍 Titik Lokasi GPS Cuci Motor & Batas Radius Absensi</h6>
                    <p class="small text-muted mb-2">
                        Karyawan hanya dapat melakukan absen jika posisi GPS mereka berada di dalam radius area cuci motor ini.
                    </p>

                    <div class="row g-2 mb-2">
                        <div class="col-md-4 col-12">
                            <label class="form-label small fw-bold">Latitude Outlet</label>
                            <input type="text" name="outlet_latitude" id="masterOutletLat" class="form-control form-control-sm" value="<%= typeof outletLatitude !== 'undefined' ? outletLatitude : '-5.149285' %>" placeholder="-5.149285" required>
                        </div>
                        <div class="col-md-4 col-12">
                            <label class="form-label small fw-bold">Longitude Outlet</label>
                            <input type="text" name="outlet_longitude" id="masterOutletLng" class="form-control form-control-sm" value="<%= typeof outletLongitude !== 'undefined' ? outletLongitude : '119.429529' %>" placeholder="119.429529" required>
                        </div>
                        <div class="col-md-4 col-12">
                            <label class="form-label small fw-bold">Radius Toleransi Absen</label>
                            <div class="input-group input-group-sm">
                                <input type="number" name="outlet_radius_meters" class="form-control" value="<%= typeof outletRadiusMeters !== 'undefined' ? outletRadiusMeters : 100 %>" min="20" max="1000" placeholder="100" required>
                                <span class="input-group-text">Meter</span>
                            </div>
                            <small class="text-muted" style="font-size:10px;">Rekomendasi: 50 – 150 meter</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nama Jalan / Detail Lokasi Outlet</label>
                        <input type="text" name="outlet_address" id="masterOutletAddr" class="form-control form-control-sm" value="<%= typeof outletAddress !== 'undefined' ? outletAddress : 'Jalan Monginsidi Baru, Green City, Rappocini, Makassar' %>" placeholder="Nama jalan detail outlet">
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="setOutletCurrentLocation()">
                                📍 Ambil Titik Lokasi dari Posisi Saya Saat Ini
                            </button>
                            <a id="btnMapsOutlet" href="https://www.google.com/maps?q=<%= typeof outletLatitude !== 'undefined' ? outletLatitude : '-5.149285' %>,<%= typeof outletLongitude !== 'undefined' ? outletLongitude : '119.429529' %>" target="_blank" class="btn btn-sm btn-outline-secondary">
                                🗺️ Buka di Google Maps
                            </a>
                        </div>
                    </div>
                    <hr class="my-3">

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Catatan Kaki Struk (Footer Thermal) <span class="text-danger">*</span></label>
                        <input type="text" name="receipt_footer" class="form-control form-control-sm" value="<%= typeof receiptFooter !== 'undefined' ? receiptFooter : 'Terima kasih atas kunjungan Anda!' %>" required placeholder="Contoh: Terima kasih atas kunjungan Anda!">
                        <small class="text-muted">Pesan penutup di bagian paling bawah struk thermal kasir.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Teks Saran & Kritik Pelanggan</label>
                        <input type="text" name="receipt_feedback" class="form-control form-control-sm" value="<%= typeof receiptFeedback !== 'undefined' ? receiptFeedback : 'Jika ada saran dan kritik silahkan hubungi 082187777080' %>" placeholder="Contoh: Jika ada saran dan kritik silahkan hubungi 082187777080">
                        <small class="text-muted">Dicetak di bawah ucapan terima kasih pada struk thermal.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Format Penomoran Nota</label>
                        <select name="receipt_number_format" class="form-select form-select-sm">
                            <option value="daily" <%= (typeof receiptNumberFormat === 'undefined' || receiptNumberFormat === 'daily') ? 'selected' : '' %>>Nomor Urut Harian (#0001, #0002 - Reset Tiap Pagi)</option>
                            <option value="date_seq" <%= (typeof receiptNumberFormat !== 'undefined' && receiptNumberFormat === 'date_seq') ? 'selected' : '' %>>Kombinasi Tanggal + Urutan (261028-001, 261028-002)</option>
                            <option value="global" <%= (typeof receiptNumberFormat !== 'undefined' && receiptNumberFormat === 'global') ? 'selected' : '' %>>Nomor ID Database Kumulatif (#0026)</option>
                        </select>
                        <small class="text-muted">Pilih format penomoran nota yang tampil dan tercetak pada struk kasir.</small>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="receipt_show_logo" id="showLogoSwitch" value="1" <%= (typeof receiptShowLogo === 'undefined' || receiptShowLogo) ? 'checked' : '' %>>
                        <label class="form-check-label small fw-bold" for="showLogoSwitch">Tampilkan Logo pada Struk Cetak Kasir</label>
                        <small class="text-muted d-block">Nonaktifkan jika printer thermal tidak mendukung gambar atau ingin mencetak lebih cepat.</small>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" name="receipt_show_qr" id="showQrSwitch" value="1" <%= (typeof receiptShowQr === 'undefined' || receiptShowQr) ? 'checked' : '' %>>
                        <label class="form-check-label small fw-bold" for="showQrSwitch">Tampilkan Barcode/QR Struk (Nota Digital Online)</label>
                        <small class="text-muted d-block">Nonaktifkan jika ingin mencetak struk lebih pendek dan hemat kertas roll thermal kasir.</small>
                    </div>

                    <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                        <button type="submit" class="btn btn-primary btn-sm px-3 shadow-sm">💾 Simpan Profil & Kustomisasi</button>
                        <a href="/receipt-preview" class="btn btn-outline-dark btn-sm">🧾 Preview Desain Struk (Thermal)</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- PENGATURAN TELEGRAM BOT NOTIFIKASI & BACKUP DOKUMEN -->
<div class="card shadow-sm mb-4 border-info">
    <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center">
        <span class="fw-bold">✈️ Notifikasi Laporan & Backup File pos.db ke Telegram</span>
        <span class="badge <%= (telegramBotToken && telegramChatId) ? 'bg-success text-white' : 'bg-warning text-dark' %>">
            <%= (telegramBotToken && telegramChatId) ? '✅ Terhubung' : '⚠️ Belum Diatur' %>
        </span>
    </div>
    <div class="card-body">
        <form action="/master/settings/telegram" method="POST" class="mb-3">
            <div class="row g-2 mb-3">
                <div class="col-md-7">
                    <label class="form-label small fw-bold">Telegram Bot Token</label>
                    <input type="text" name="bot_token" id="telegramTokenInput" class="form-control form-control-sm font-monospace" placeholder="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ" value="<%= telegramBotToken %>" required>
                    <small class="text-muted">Token bot yang didapat dari <strong>@BotFather</strong>.</small>
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-bold">Telegram Chat ID (Owner / Grup)</label>
                    <input type="text" name="chat_id" id="telegramChatIdInput" class="form-control form-control-sm font-monospace" placeholder="123456789 atau -100123456789" value="<%= telegramChatId %>" required>
                    <small class="text-muted">ID akun Telegram Anda (didapat dari <strong>@userinfobot</strong>).</small>
                </div>
            </div>

            <div class="d-flex gap-2 mb-3">
                <button type="submit" class="btn btn-primary btn-sm">💾 Simpan Pengaturan Telegram</button>
                <button type="button" class="btn btn-outline-info btn-sm text-dark fw-bold" id="btnTestTelegram" onclick="testTelegram()">🧪 Test Kirim ke Telegram</button>
            </div>

            <!-- JADWAL OTOMATIS PENUTUPAN KASIR -->
            <div class="border rounded p-3 bg-light mb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" name="auto_send" id="autoSendSwitch" value="1" <%= (typeof telegramAutoSend === 'undefined' || telegramAutoSend) ? 'checked' : '' %>>
                        <label class="form-check-label fw-bold" for="autoSendSwitch">Kirim Laporan & File pos.db Otomatis Setiap Hari</label>
                    </div>
                    <span class="badge <%= (typeof telegramLastReportDate !== 'undefined' && telegramLastReportDate === new Date().toISOString().slice(0, 10)) ? 'bg-success' : 'bg-secondary' %>">
                        <%= (typeof telegramLastReportDate !== 'undefined' && telegramLastReportDate === new Date().toISOString().slice(0, 10)) ? '✅ Laporan Hari Ini Sudah Terkirim' : '⏳ Menunggu Jadwal Jam Tutup' %>
                    </span>
                </div>
                <div class="row g-2 align-items-center">
                    <div class="col-md-4">
                        <label class="form-label small mb-1 fw-bold">Jam Pengiriman Otomatis</label>
                        <input type="time" name="auto_send_time" class="form-control form-control-sm" value="<%= typeof telegramAutoSendTime !== 'undefined' && telegramAutoSendTime ? telegramAutoSendTime : '20:00' %>" required>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small mb-1 fw-bold">Zona Waktu Outlet</label>
                        <select name="timezone" class="form-select form-select-sm">
                            <option value="Asia/Makassar" <%= (typeof telegramTimezone !== 'undefined' && telegramTimezone === 'Asia/Makassar') ? 'selected' : '' %>>WITA (Makassar, Bali, dll)</option>
                            <option value="Asia/Jakarta" <%= (typeof telegramTimezone !== 'undefined' && telegramTimezone === 'Asia/Jakarta') ? 'selected' : '' %>>WIB (Jakarta, Jawa, Sumatera)</option>
                            <option value="Asia/Jayapura" <%= (typeof telegramTimezone !== 'undefined' && telegramTimezone === 'Asia/Jayapura') ? 'selected' : '' %>>WIT (Papua, Maluku)</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-sm btn-dark w-100">Simpan Jadwal</button>
                    </div>
                </div>
                <small class="text-muted d-block mt-2">
                    💡 Setiap hari saat jam tutup, bot Telegram akan otomatis mengirimkan ringkasan kasir hari itu <strong>beserta file fisik pos.db asli</strong> langsung menempel di chat Telegram Anda!
                </small>
            </div>
        </form>

        <div id="telegramTestFeedback" class="alert d-none py-2 small mb-3"></div>

        <div class="card bg-light border-0">
            <div class="card-body p-3 small">
                <h6 class="fw-bold mb-2">Cara Cepat Membuat Bot Telegram (Hanya 1 Menit):</h6>
                <ol class="mb-0 ps-3">
                    <li class="mb-1">Buka aplikasi Telegram, cari akun resmi <strong>@BotFather</strong>, lalu klik <strong>Start</strong>.</li>
                    <li class="mb-1">Ketik <code>/newbot</code>, beri nama bot Anda (misal: <code>WashPOS Kasir Bot</code>) dan buat username berakhiran 'bot' (misal: <code>washpos_outlet_bot</code>).</li>
                    <li class="mb-1">Salin kode <strong>HTTP API Token</strong> yang diberikan dan tempel pada kolom <strong>Bot Token</strong> di atas.</li>
                    <li class="mb-1">Buka bot yang baru saja Anda buat, lalu klik <strong>Start</strong> agar bot diizinkan mengirim pesan ke Anda.</li>
                    <li class="mb-1">Cari akun <strong>@userinfobot</strong> di Telegram, klik <strong>Start</strong>, lalu salin angka <strong>Id</strong> Anda ke kolom <strong>Chat ID</strong> di atas.</li>
                    <li>Klik tombol <strong>Simpan Pengaturan Telegram</strong> lalu klik <strong>Test Kirim ke Telegram</strong>!</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<script>
async function testTelegram() {
    const btn = document.getElementById('btnTestTelegram');
    const fb = document.getElementById('telegramTestFeedback');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Menguji...';
    fb.className = 'alert alert-info py-2 small';
    fb.textContent = 'Menghubungi Telegram...';
    fb.classList.remove('d-none');

    try {
        const res = await fetch('/api/telegram/test', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
            fb.className = 'alert alert-success py-2 small';
            fb.textContent = '✅ ' + data.message;
        } else {
            fb.className = 'alert alert-danger py-2 small';
            fb.textContent = '❌ ' + data.message;
        }
    } catch (e) {
        fb.className = 'alert alert-danger py-2 small';
        fb.textContent = '❌ Error koneksi: ' + e.message;
    } finally {
        btn.disabled = false;
        btn.innerHTML = '🧪 Test Kirim ke Telegram';
    }
}
</script>

<!-- CADANGAN & UNDUH DATABASE (pos.db) -->
<div class="card shadow-sm mb-4 border-dark">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <span class="fw-bold">💾 Cadangan Database SQLite (pos.db)</span>
        <span class="badge bg-success">Auto-Synced Supabase Cloud</span>
    </div>
    <div class="card-body">
        <p class="small text-muted mb-3">
            Semua data riwayat transaksi penjualan kasir, pengeluaran, akun kas, master layanan, pekerja, dan komisi tersimpan permanen di dalam berkas database SQLite <code>pos.db</code>. Sistem WashPOS secara otomatis mencadangkan file ini ke Cloud Storage Supabase setiap kali ada transaksi dan saat penutupan server.
        </p>

        <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
            <a href="/master/backup/download" class="btn btn-dark btn-sm">
                📥 Unduh File pos.db (Backup Terbaru)
            </a>
            <span class="badge bg-light text-dark border">
                Ukuran file di server: <strong><%= typeof dbSizeStr !== 'undefined' ? dbSizeStr : 'Siap' %></strong>
            </span>
        </div>

        <div class="alert alert-light border small mb-0">
            <h6 class="fw-bold mb-1">Cara Melihat / Membuka Isi File pos.db:</h6>
            <ol class="mb-0 ps-3">
                <li>Klik tombol <strong>"Unduh File pos.db"</strong> di atas untuk menyimpan file cadangan ke komputer atau smartphone Anda.</li>
                <li>Buka browser dan buka situs gratis: <a href="https://sqliteviewer.app/" target="_blank" class="fw-bold">sqliteviewer.app</a> atau gunakan software komputer <strong>DB Browser for SQLite</strong>.</li>
                <li>Tarik (drag & drop) file <code>pos.db</code> yang baru Anda unduh ke situs tersebut. Semua data tabel transaksi (<code>sales</code>, <code>expenses</code>, <code>services</code>, <code>workers</code>) dapat Anda lihat dan telusuri layaknya tabel Excel.</li>
            </ol>
        </div>
    </div>
</div>

<!-- RESET DATA TRANSAKSI (UJI COBA ULANG) -->
<div class="card shadow-sm mb-4 border-danger">
    <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
        <span class="fw-bold">⚠️ Reset Riwayat Transaksi (Khusus Pengujian / Uji Coba)</span>
        <span class="badge bg-light text-danger">Opsi A: Transaksi Saja</span>
    </div>
    <div class="card-body">
        <p class="small text-muted mb-3">
            Fitur ini digunakan saat Anda ingin menguji ulang alur sistem kasir dari awal. Tombol ini akan menghapus semua riwayat transaksi penjualan nota kasir, komisi cuci, catatan pengeluaran, saldo/jurnal kas, absensi, dan riwayat stok.
            <br>
            <strong class="text-success">Data Master Aman:</strong> Akun login kasir/owner, daftar karyawan, daftar layanan & harga, akun kas, dan kategori biaya <strong>TETAP DISIMPAN</strong>.
        </p>
        <button type="button" class="btn btn-outline-danger btn-sm" onclick="openResetTransactionsModal()">
            🗑️ Reset Riwayat Transaksi Sekarang
        </button>
    </div>
</div>

<!-- Modal Konfirmasi Reset Transaksi -->
<div class="modal fade" id="modalResetTransactions" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/master/reset-transactions" method="POST" class="modal-content border-danger">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title">⚠️ Konfirmasi Reset Riwayat Transaksi</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-danger fw-bold mb-2">
                    Tindakan ini akan mengosongkan seluruh riwayat transaksi penjualan, komisi, pengeluaran kas, mutasi kas, dan absensi!
                </p>
                <p class="small text-muted mb-3">
                    Data master akun login, layanan, dan karyawan tetap aman. Untuk melanjutkan, silakan masukkan kata sandi akun Owner Anda:
                </p>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Kata Sandi Akun Owner</label>
                    <input type="password" name="owner_password" class="form-control form-control-sm" required placeholder="Masukkan kata sandi owner">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                <button type="submit" class="btn btn-danger btn-sm fw-bold">Ya, Bersihkan Data Transaksi</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Edit Karyawan & Tarif Gaji Harian -->
<div class="modal fade" id="modalEditWorker" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="/master/workers/update" method="POST" onsubmit="return validateRupiahForm(this)">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">✏️ Edit Data & Tarif Gaji Karyawan</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="editWorkerId">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nama Karyawan / Admin <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="editWorkerName" class="form-control" required minlength="2">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Posisi / Jabatan</label>
                        <select name="role" id="editWorkerRole" class="form-select">
                            <option value="Pencuci">Pencuci Motor</option>
                            <option value="Admin">Admin / Kasir</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tanggal Masuk</label>
                        <input type="date" name="join_date" id="editWorkerJoinDate" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tarif Gaji Pokok Harian (Rp)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold">Rp</span>
                            <input type="text" name="daily_salary" id="editWorkerDailySalary" class="form-control rupiah-input" placeholder="0">
                        </div>
                        <small class="text-muted">Tarif gaji harian dihitung per hari hadir absen masuk (off mingguan tidak dihitung gaji).</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-warning-emphasis">🎁 Bonus Kerajinan / Masuk Full (Rp)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-warning bg-opacity-25 fw-bold">Rp</span>
                            <input type="text" name="bonus_rajin" id="editWorkerBonusRajin" class="form-control rupiah-input" placeholder="150.000">
                        </div>
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" role="switch" id="editWorkerBonusEnabled" name="bonus_enabled" value="1">
                            <label class="form-check-label small fw-bold" for="editWorkerBonusEnabled">Aktifkan Bonus Masuk Full untuk karyawan ini</label>
                        </div>
                        <small class="text-muted">Bonus otomatis hanya dihitung jika saklar aktif &amp; karyawan hadir memenuhi target periode.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">No WhatsApp (Opsional)</label>
                        <input type="text" name="phone" id="editWorkerPhone" class="form-control" placeholder="08xxxxxxxxxx">
                        <small class="text-muted">Digunakan untuk kirim slip gaji otomatis via WhatsApp.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary fw-bold">Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function openEditWorkerModal(worker) {
    document.getElementById('editWorkerId').value = worker.id;
    document.getElementById('editWorkerName').value = worker.name || '';
    document.getElementById('editWorkerRole').value = worker.role || 'Pencuci';
    document.getElementById('editWorkerJoinDate').value = worker.join_date || '';
    document.getElementById('editWorkerDailySalary').value = (worker.daily_salary || 0).toLocaleString('id-ID');
    const defaultBonus = <%= (typeof fullAttendanceBonus !== 'undefined') ? fullAttendanceBonus : 150000 %>;
    const workerBonus = (worker.bonus_rajin !== undefined && worker.bonus_rajin !== null && !isNaN(worker.bonus_rajin)) ? worker.bonus_rajin : defaultBonus;
    document.getElementById('editWorkerBonusRajin').value = Number(workerBonus).toLocaleString('id-ID');
    document.getElementById('editWorkerBonusEnabled').checked = (Number(worker.bonus_enabled) === 1);
    document.getElementById('editWorkerPhone').value = worker.phone || '';
    
    const modal = new bootstrap.Modal(document.getElementById('modalEditWorker'));
    modal.show();
}

function openResetTransactionsModal() {
    new bootstrap.Modal(document.getElementById('modalResetTransactions')).show();
}

function setOutletCurrentLocation() {
    if (!navigator.geolocation) return alert('Geolocation tidak didukung browser ini');
    const btn = event.target;
    const oldText = btn.textContent;
    btn.textContent = 'Mencari Lokasi GPS...';
    btn.disabled = true;
    navigator.geolocation.getCurrentPosition(async pos => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;
        document.getElementById('masterOutletLat').value = lat.toFixed(6);
        document.getElementById('masterOutletLng').value = lng.toFixed(6);
        document.getElementById('btnMapsOutlet').href = `https://www.google.com/maps?q=${lat},${lng}`;

        btn.textContent = 'Mencari nama jalan detail...';
        try {
            let street = '';
            let district = '';
            let city = '';
            try {
                const p = await (await fetch(`https://photon.komoot.io/reverse?lat=${lat}&lon=${lng}`)).json();
                if (p.features && p.features[0]) {
                    const pr = p.features[0].properties || {};
                    street = pr.street || pr.name || '';
                    district = pr.district || '';
                    city = pr.city || '';
                }
            } catch(e) {}
            try {
                const n = await (await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`, { headers: { 'User-Agent': 'WashPOS/1.0' } })).json();
                const a = n.address || {};
                const nomStreet = a.road || a.pedestrian || '';
                if (nomStreet) street = nomStreet;
                const res = a.residential || a.neighbourhood || '';
                const dist = a.suburb || a.city_district || district;
                const c = a.city || city;
                const parts = [street, res, dist, c].filter(Boolean).filter((v,i,arr)=>arr.indexOf(v)===i);
                if (parts.length > 0) {
                    document.getElementById('masterOutletAddr').value = parts.join(', ');
                }
            } catch(e) {}
        } catch(e) {}
        btn.textContent = oldText;
        btn.disabled = false;
        alert('Titik lokasi berhasil didapat: ' + lat.toFixed(6) + ', ' + lng.toFixed(6) + '\n\nSilakan klik tombol "Simpan Profil Usaha" di bawah untuk menyimpan perubahan.');
    }, err => {
        btn.textContent = oldText;
        btn.disabled = false;
        alert('Gagal mengambil lokasi GPS: ' + err.message);
    }, { enableHighAccuracy: true, timeout: 10000 });
}
</script>

